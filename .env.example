SESSION_SECRET=una-cadena-larga-random-aqui
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Supabase Storage (opcional) ──
# Si se configuran, las fotos de remitos se guardan en Supabase Storage
# (persisten entre reinicios). Si se dejan vacías, se usan archivos locales.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta
SUPABASE_BUCKET=remitos

# ── Geocodificación (Nominatim / OpenStreetMap, opcional) ──
# Identifican a la app ante Nominatim (política de uso). Si no se configuran, se usa
# un User-Agent por defecto y no se manda e-mail de contacto.
NOMINATIM_USER_AGENT=SuelosurGestion/1.0 (sistema interno de logistica de contenedores)
NOMINATIM_EMAIL=
