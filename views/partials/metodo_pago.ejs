<!-- Componente reutilizable: Metodo de pago -->
<%#
  Locals opcionales:
    conAConvenir  → ofrece "A convenir una vez finalizado".
    soloFacturar  → solo la sección "Operación para Facturar" (sin el selector de método).
    sinFacturar   → solo el selector de método (sin el check de facturar).
%>
<%
  const _soloFacturar = typeof soloFacturar !== 'undefined' && soloFacturar
  const _sinFacturar  = typeof sinFacturar  !== 'undefined' && sinFacturar
%>
<div class="form-section">
    <% if (_soloFacturar) { %>
    <h3 class="form-section__title">Facturación</h3>
    <% } else { %>
    <h3 class="form-section__title">Metodo de pago</h3>
    <div class="form-group">
        <label for="metodoPago">Metodo</label>
        <select name="metodoPago" id="metodoPago" required>
            <option value="efectivo">Efectivo</option>
            <option value="transferencia">Transferencia bancaria</option>
            <option value="cheque">Cheque</option>
            <option value="cuenta_corriente" id="opcionCuentaCorriente" style="display:none">Cuenta corriente</option>
            <option value="saldo_a_favor" id="opcionSaldoFavor" style="display:none">Usar saldo a favor del cliente</option>
            <% if (typeof conAConvenir !== 'undefined' && conAConvenir) { %>
                <option value="a_convenir">A convenir una vez finalizado</option>
            <% } %>
        </select>
        <% if (typeof conAConvenir !== 'undefined' && conAConvenir) { %>
            <p class="form-hint">Con "A convenir" el método se define al retirar el contenedor: ahí hay que elegir uno o marcarlo pendiente de pago.</p>
        <% } %>
        <p class="form-hint" id="hintSaldoFavor" style="display:none"></p>
    </div>
    <% } %>
    <% if (!_sinFacturar) { %>
    <label class="toggle-row mt-2" for="paraFacturar">
        <input type="checkbox" name="paraFacturar" id="paraFacturar" value="1">
        Operación para Facturar
    </label>
    <% } %>
</div>
