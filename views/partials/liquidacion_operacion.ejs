<%# Tarjeta de una operación de la liquidación. Recibe: o (operación), ESTADOS y, opcional,
    saldar ({ idCliente, nombre }): botón "Marcar como pagada" en las que deben algo en la cuenta corriente.
    Dueño y administración contable también pueden marcarla pendiente / pagada (public/js/estadoPago.js). %>
<% const $ = (n) => '$' + Number(n || 0).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
<% const puedeCambiarPago = !!locals.user && ['dueno', 'admin_contable'].includes(user.rol) %>
<% const nroTxt = o.nro_remito ? 'Remito ' + o.nro_remito : 'OP-' + String(o.nro_op).padStart(4, '0') %>
<%# Lo que todavía no es deuda lo dice: un alquiler en curso, o algo sin entregar que no está en la cuenta %>
<% const estadoTxt = o.estado === 'pendiente' && o.enCurso ? 'En curso'
     : o.estado === 'pendiente' && !o.enCuenta && ['pendiente', 'despachado'].includes(o.estadoOp) ? 'Sin entregar'
     : ESTADOS[o.estado] %>
<div class="liq-op liq-op--<%= o.estado %>">
  <div class="liq-op__head">
    <div class="liq-op__titulo">
      <%# Selección para marcar / quitar "para facturar" en grupo (public/js/liquidacionesFacturar.js) %>
      <input type="checkbox" class="liq-op__sel js-liq-sel" value="<%= o.id %>"
             aria-label="Seleccionar <%= nroTxt %>" data-neto="<%= o.neto || 0 %>" data-iva="<%= o.iva || 0 %>"
             data-marcada="<%= o.paraFacturar ? 1 : 0 %>" <%= o.facturado ? 'disabled title="Ya facturada"' : '' %>>
      <strong><%= nroTxt %></strong>
      <span><%= formatFecha(o.fecha) %></span>
      <span><%= o.tipoTexto %></span>
      <% if (o.obra) { %><span>Obra: <%= o.obra %></span><% } %>
    </div>
    <div class="liq-op__acciones">
      <% if (o.facturado) { %><span class="badge badge-activo">Facturada</span><% } else if (o.paraFacturar) { %><span class="badge badge-pendiente">Para facturar</span><% } %>
      <span class="liq-estado liq-estado--<%= o.estado %>"><%= estadoTxt %></span>
      <% const href = o.tipo === 'contenedor' ? '/alquileres/contenedores/' + o.id : o.tipo === 'maquinaria' ? '/alquileres/maquinaria/' + o.id : '/ventas/' + o.id %>
      <div class="acciones-fila">
        <%- include('btn_icono', { icono: 'eye', etiqueta: 'Ver detalle', clase: 'btn-outline-secondary', href: href }) %>
        <%# Agregar / editar el N° de factura (public/js/nroFactura.js); la facturada y la anulada no lo llevan %>
        <%- include('boton_nro_factura', { nombreOp: nroTxt, op: { id: o.id, nro_op: o.nro_op, nro_factura: o.nroFactura, facturado: o.facturado, estado: o.estadoOp } }) %>
      </div>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-sm liq-op__tabla mb-0">
      <thead><tr><th>Detalle</th><th class="text-end">Cant.</th><th>Unid.</th><th class="text-end">P. unit.</th><th class="text-end">Importe</th></tr></thead>
      <tbody>
        <% o.renglones.forEach(r => { %>
          <tr>
            <td><%= r.descripcion %></td>
            <td class="text-end"><%= Number(r.cantidad).toLocaleString('es-AR') %></td>
            <td><%= r.unidad %></td>
            <td class="text-end"><%= $(r.precio_unit) %></td>
            <td class="text-end"><%= $(r.importe) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="liq-op__pie">
    <span class="text-muted">Pago: <%= o.metodoTexto %></span>
    <% if (o.estado === 'a_convenir') { %>
      <span class="text-muted">Precio a convenir</span>
    <% } else { %>
      <span>Total <strong><%= $(o.total) %></strong><% if (o.estimado) { %> <small class="text-muted" title="Alquiler todavía sin cobrar: lo que se cobraría hoy">(estimado a hoy)</small><% } %></span>
      <span class="text-success">Pagado <strong><%= $(o.pagado) %></strong></span>
      <span class="<%= o.resta > 0.005 ? 'text-danger' : 'text-success' %>">Resta <strong><%= $(o.resta) %></strong></span>
      <%# Marcar como pagada: lo que le falta exacto, aplicado a esta operación (las de un alquiler cobrado todo junto se saldan desde la cuenta) %>
      <% if (locals.saldar && o.enCuenta && !o.grupoTodoJunto && o.resta > 0.005) { %>
        <%- include('btn_icono', { icono: 'checkCircle', etiqueta: 'Marcar como pagada', clase: 'btn-outline-success btn-abonar',
              attrs: { 'data-id': saldar.idCliente, 'data-nombre': saldar.nombre, 'data-clave': 'op:' + o.id, 'data-deuda': o.resta, 'data-descripcion': nroTxt + ' · ' + o.tipoTexto } }) %>
      <% } else if (puedeCambiarPago && !['cuenta_corriente', 'saldo_a_favor'].includes(o.metodo_pago) && !o.grupoTodoJunto && !o.enCurso && !o.estimado
                    && !['pendiente', 'despachado'].includes(o.estadoOp) && o.resta > 0.005) { %>
        <%# Venta de contado sin cobro registrado: se registra el cobro por lo que falta %>
        <%- include('btn_icono', { icono: 'checkCircle', etiqueta: 'Marcar como pagada', clase: 'btn-outline-success btn-estado-pago',
              attrs: { 'data-id': o.id, 'data-accion': 'pagada', 'data-nombre': nroTxt + ' · ' + o.tipoTexto } }) %>
      <% } %>
      <%# Marcar pendiente: quita los pagos aplicados (en cuenta corriente) o pasa el cobro de contado a cuenta corriente %>
      <% if (puedeCambiarPago && (o.estado === 'pagada' || o.estado === 'parcial') && !o.estimado) { %>
        <%- include('btn_icono', { icono: 'clock', etiqueta: 'Marcar pendiente', clase: 'btn-outline-danger btn-estado-pago',
              attrs: { 'data-id': o.id, 'data-accion': 'pendiente', 'data-nombre': nroTxt + ' · ' + o.tipoTexto } }) %>
      <% } %>
    <% } %>
  </div>
</div>
