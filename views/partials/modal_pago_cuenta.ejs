<%#
  Modal "Registrar pago" de la cuenta corriente (public/js/modalAbonar.js). Lo abre cualquier
  botón .btn-abonar con data-id (cliente), data-nombre, data-deuda y, para "Saldar" una
  operación puntual, data-clave ('op:ID' o 'cargo:ID') y data-descripcion.
  Carga lo que debe el cliente (GET /clientes/:id/cuenta/pendientes) y deja elegir a qué
  operaciones se aplica el pago: las más antiguas primero, las más nuevas primero o a mano.
  Lo que no se elige se aplica a las deudas más antiguas; si sobra, queda a favor.
%>
<div id="modal-abonar" class="modal-overlay" style="display:none">
  <div class="modal-box modal-box--lg" role="dialog" aria-modal="true" aria-labelledby="modal-abonar-titulo">
    <div class="modal-header">
      <h2 class="modal-title" id="modal-abonar-titulo"><span id="modal-abonar-accion">Registrar pago</span> — <span id="modal-abonar-nombre"></span></h2>
      <button type="button" class="modal-close" id="cerrarModalAbonar" aria-label="Cerrar">✕</button>
    </div>
    <div class="modal-body">
      <div class="abonar-resumen">
        <p class="abonar-resumen__label" id="modal-abonar-deuda-label">Deuda en cuenta corriente</p>
        <div class="abonar-resumen__monto" id="modal-abonar-deuda"></div>
        <p id="modal-abonar-concepto" class="abonar-resumen__concepto d-none"></p>
      </div>
      <form id="formAbonar" method="POST">
        <input type="hidden" name="descripcion" id="inputDescripcionAbonar">
        <input type="hidden" name="imputaciones" id="inputImputaciones" value="[]">
        <div class="pago-cuenta__datos">
          <div class="form-group">
            <div class="d-flex justify-content-between align-items-center">
              <label for="inputMonto" class="mb-0">Monto que entrega el cliente</label>
              <button type="button" class="abonar-quickfill" id="btnPagarTotal">Usar el total</button>
            </div>
            <div class="abonar-input-monto">
              <input type="number" name="monto" id="inputMonto" min="0.01" step="0.01" required placeholder="0" inputmode="decimal">
            </div>
          </div>
          <div class="form-group">
            <label for="inputMetodoAbonar">Método de pago</label>
            <select name="metodo_pago" id="inputMetodoAbonar" data-tercero>
              <option value="efectivo">Efectivo</option>
              <option value="transferencia">Transferencia</option>
              <option value="cheque">Cheque</option><option value="echeq">Echeq</option>
            </select>
          </div>
          <%- include('fecha_pago', { nombre: 'fecha', idCampo: 'inputFechaAbonar', metodoSel: '' }) %>
        </div>

        <%# Qué operaciones paga (se completa con lo que debe el cliente) %>
        <section class="pago-cuenta__ops" id="pagoOperaciones" hidden>
          <div class="pago-cuenta__ops-cabecera">
            <h3 class="pago-cuenta__titulo">¿Qué operaciones paga?</h3>
            <div class="pago-cuenta__acciones">
              <button type="button" class="abonar-quickfill" id="pagoMarcarTodas">Marcar todas</button>
              <span aria-hidden="true">·</span>
              <button type="button" class="abonar-quickfill" id="pagoDesmarcarTodas">Ninguna</button>
            </div>
          </div>
          <div class="pago-cuenta__criterios" role="radiogroup" aria-label="Cómo se reparte el pago">
            <label class="pago-cuenta__criterio"><input type="radio" name="criterioPago" value="antiguas" checked> Las más antiguas primero</label>
            <label class="pago-cuenta__criterio"><input type="radio" name="criterioPago" value="nuevas"> Las más nuevas primero</label>
            <label class="pago-cuenta__criterio"><input type="radio" name="criterioPago" value="manual"> Elegir los importes a mano</label>
          </div>
          <div class="pago-cuenta__lista" id="pagoLista"></div>
          <p class="pago-cuenta__resumen" id="pagoResumen" aria-live="polite"></p>
        </section>
        <p class="form-hint d-none" id="pagoSinDeuda">El cliente no tiene deudas en su cuenta corriente: el pago queda a favor y se descuenta solo de sus próximas compras.</p>

        <div class="modal-actions">
          <button type="button" class="btn btn-outline-secondary" id="cancelarModalAbonar">Cancelar</button>
          <button type="submit" class="btn btn-success" id="confirmarPago">Confirmar pago</button>
        </div>
      </form>
    </div>
  </div>
</div>
