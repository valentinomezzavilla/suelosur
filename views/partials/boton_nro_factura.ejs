<%#
  Botón de N° de factura de una operación, para la columna de acciones (dentro de .acciones-fila) de
  Ventas, Alquileres, Liquidaciones y Cuenta corriente. Es de solo ícono (partials/btn_icono.ejs):
    sin número  → documento con "+"  · tono neutro   · "Agregar N°Factura"
    con número  → documento escrito  · tono de acento · "Editar N°Factura: <número>" (se ve de un vistazo cuál ya tiene)
  Recibe `op` ({ id, nro_op, nro_factura, facturado, estado }) y, opcional, `nombreOp` (cómo se llama
  la operación en el título del modal; por defecto OP-0001: la Liquidación la nombra por remito).
  No se muestra en una operación ya facturada (su número es el de la factura registrada) ni
  anulada, ni para quien no carga operaciones. Lo abre public/js/nroFactura.js con el modal
  views/partials/modal_nro_factura.ejs, que cada pantalla incluye una vez.
%>
<%
  const _op = locals.op
  const _puede = !!(locals.user && ['admin_ventas', 'admin_contable', 'dueno'].includes(locals.user.rol))
%>
<% if (_op && _puede && Number(_op.facturado) !== 1 && _op.estado !== 'anulado') { %>
  <%- include('btn_icono', {
    icono: _op.nro_factura ? 'fileText' : 'filePlus',
    etiqueta: _op.nro_factura ? 'Editar N°Factura: ' + _op.nro_factura : 'Agregar N°Factura',
    clase: (_op.nro_factura ? 'btn-outline-primary' : 'btn-outline-secondary') + ' btn-nro-factura',
    attrs: { 'data-id': _op.id, 'data-nombre': locals.nombreOp || 'OP-' + String(_op.nro_op).padStart(4, '0'), 'data-nro': _op.nro_factura || '' },
  }) %>
<% } %>
