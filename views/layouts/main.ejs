<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suelosur — Sistema de Gestión</title>
  <link rel="icon" type="image/jpeg" href="/img/suelosurjpg.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/main.css">
  <script>try{if(localStorage.getItem('sidebarCollapsed')==='1')document.documentElement.classList.add('sidebar-collapsed')}catch(e){}</script>
</head>
<body>
  <div class="app-wrapper">
    <%- include('../partials/sidebar') %>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="flex-grow-1 d-flex flex-column min-w-0">
      <%- include('../partials/navbar') %>
      <main class="main-content">
        <%- include('../partials/alerts') %>
        <%- body %>
      </main>
    </div>
  </div>
  <%- include('../partials/loader') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/appLoader.js"></script>
  <script src="/js/mapService.js"></script>
  <script src="/js/main.js"></script>
  <% if (user && user.rol === 'chofer') { %>
    <script src="/js/choferTracking.js"></script>
  <% } %>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach(function(s){ %>
    <script src="<%= s %>"></script>
  <% }) %>
</body>
</html>
