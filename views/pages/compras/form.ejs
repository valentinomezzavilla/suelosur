<%
  const CAT_LABEL = {
    material: 'Material (ingresa a stock)',
    sueldo: 'Sueldo',
    seguro: 'Seguro',
    proveedor: 'Pago a proveedor',
    mantenimiento: 'Mantenimiento / Service',
    combustible: 'Combustible',
    impuesto: 'Impuesto / Multa',
    otro: 'Otro',
  }
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0 text-dark-title"><%- icon('receipt', { size: 18 }) %> Registrar compra / pago</h4>
  <a href="/compras" class="btn btn-sm btn-outline-secondary">← Volver</a>
</div>

<div class="card shadow-sm" style="max-width:720px">
  <div class="card-body">
    <form action="/compras" method="POST" id="formEgreso">

      <!-- Categoría -->
      <div class="mb-3">
        <label class="form-label">¿Qué es? *</label>
        <select name="categoria" id="categoria" class="form-select" required>
          <option value="">Seleccionar…</option>
          <% categorias.forEach(c => { %><option value="<%= c %>"><%= CAT_LABEL[c] || c %></option><% }) %>
        </select>
      </div>

      <!-- Material (solo categoría material) -->
      <div class="cond" data-cats="material" style="display:none">
        <div class="mb-3">
          <label class="form-label">Producto *</label>
          <select name="id_producto" id="id_producto" class="form-select">
            <option value="">Seleccionar…</option>
            <% productos.forEach(p => { %><option value="<%= p.id %>"><%= p.nombre %> (<%= p.unidad_medida %>)</option><% }) %>
          </select>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-4"><label class="form-label">Cantidad *</label><input type="number" step="0.01" min="0.01" name="cantidad" id="cantidad" class="form-control"></div>
          <div class="col-md-4"><label class="form-label">Costo unitario</label><input type="number" step="0.01" min="0" name="costo_unitario" id="costo_unitario" class="form-control" placeholder="0"></div>
          <div class="col-md-4"><label class="form-label">Costo flete</label><input type="number" step="0.01" min="0" name="costo_flete" id="costo_flete" class="form-control" placeholder="0"></div>
        </div>
        <div class="mb-3">
          <label class="form-label">Fletero</label>
          <input type="text" name="fletero" id="fletero" class="form-control" placeholder="Nombre del fletero o empresa de transporte">
        </div>
      </div>

      <!-- Proveedor (material o proveedor) -->
      <div class="cond mb-3" data-cats="material proveedor" style="display:none">
        <label class="form-label">Proveedor</label>
        <input type="text" id="buscarProv" class="form-control form-control-sm mb-1" placeholder="Buscar por razón social o CUIT…">
        <select name="id_proveedor" id="selProv" class="form-select">
          <option value="">— Sin proveedor —</option>
          <% proveedores.forEach(p => { %><option value="<%= p.id %>" data-search="<%= (p.nombre + ' ' + (p.cuit||'')).toLowerCase() %>"><%= p.nombre %><%= p.cuit ? ' (' + p.cuit + ')' : '' %></option><% }) %>
        </select>
      </div>

      <!-- Empleado (sueldo) -->
      <div class="cond mb-3" data-cats="sueldo" style="display:none">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label">Empleado *</label>
            <select name="id_empleado" id="id_empleado" class="form-select">
              <option value="">Seleccionar…</option>
              <% empleados.forEach(e => { %><option value="<%= e.id %>" data-sueldo="<%= Number(e.sueldo_basico || e.salario || 0) %>"><%= e.nombre %> <%= e.apellido || '' %><%= e.legajo ? ' — Legajo ' + e.legajo : '' %></option><% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Período</label>
            <input type="month" name="periodo" id="periodo" class="form-control" value="<%= new Date().toISOString().slice(0,7) %>">
          </div>
        </div>
      </div>

      <!-- Vehículo (seguro / mantenimiento / combustible / impuesto) -->
      <div class="cond mb-3" data-cats="seguro mantenimiento combustible impuesto" style="display:none">
        <label class="form-label">Vehículo</label>
        <select name="id_vehiculo" id="id_vehiculo" class="form-select">
          <option value="">— Sin vehículo —</option>
          <% vehiculos.forEach(v => { %><option value="<%= v.id %>"><%= [v.numero_interno ? '#' + v.numero_interno : null, v.patente, v.nombre].filter(Boolean).join(' · ') %></option><% }) %>
        </select>
      </div>

      <!-- Comunes -->
      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <label class="form-label">Fecha</label>
          <input type="date" name="fecha" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="col-md-4">
          <label class="form-label" id="lblMonto">Monto *</label>
          <input type="number" step="0.01" min="0" name="monto" id="monto" class="form-control" placeholder="0" required>
          <small class="text-muted cond" data-cats="material" style="display:none">Se calcula con (cantidad × costo unitario) + flete.</small>
          <small class="text-muted cond" data-cats="sueldo" id="ayudaSueldo" style="display:none">Se completa con el sueldo establecido del empleado (podés cambiarlo).</small>
          <label class="toggle-row toggle-sm mt-1 cond" data-cats="material" style="display:none">
            <input type="checkbox" id="checkEditarMonto">
            <span>Editar manualmente</span>
          </label>
        </div>
        <div class="col-md-4">
          <label class="form-label">Método de pago</label>
          <select name="metodo_pago" class="form-select">
            <option value="">—</option>
            <option value="efectivo">Efectivo</option>
            <option value="transferencia">Transferencia</option>
            <option value="cheque">Cheque</option>
          </select>
        </div>
      </div>

      <!-- Sueldo: descuentos, adiciones y neto -->
      <div class="cond row g-3 mb-3" data-cats="sueldo" style="display:none">
        <div class="col-md-4">
          <label class="form-label">Descuentos</label>
          <input type="number" step="0.01" min="0" name="descuentos" id="descuentos" class="form-control" placeholder="0">
          <small class="text-muted">Lo que se le descuenta al sueldo.</small>
        </div>
        <div class="col-md-4">
          <label class="form-label">Adiciones</label>
          <input type="number" step="0.01" min="0" name="adiciones" id="adiciones" class="form-control" placeholder="0">
          <small class="text-muted">Bonificaciones que se le suman.</small>
        </div>
        <div class="col-md-4">
          <label class="form-label">Neto a pagar</label>
          <input type="text" id="netoSueldo" class="form-control input-readonly fw-bold" readonly value="$0">
          <small class="text-muted">Sueldo − descuentos + adiciones.</small>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label">Descripción</label>
        <input type="text" name="descripcion" id="descripcion" class="form-control" placeholder="Detalle, N° de comprobante, período…">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-naranja px-4">Registrar</button>
        <a href="/compras" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const cat = document.getElementById('categoria')
    const conds = Array.from(document.querySelectorAll('.cond'))
    const monto = document.getElementById('monto')
    const cantidad = document.getElementById('cantidad')
    const costo = document.getElementById('costo_unitario')
    const flete = document.getElementById('costo_flete')

    function toggle() {
      const v = cat.value
      conds.forEach(el => {
        const cats = (el.dataset.cats || '').split(' ')
        el.style.display = cats.includes(v) ? '' : 'none'
      })
      aplicarBloqueoMonto()
      const lblMonto = document.getElementById('lblMonto')
      if (lblMonto) lblMonto.textContent = v === 'sueldo' ? 'Sueldo *' : 'Monto *'
      if (v === 'sueldo') { traerSueldo(); calcNeto() }
    }
    cat.addEventListener('change', toggle)

    // Sueldo: al elegir el empleado, el monto se completa con el sueldo establecido en su
    // ficha; con descuentos y adiciones se calcula el neto que se paga.
    const selEmpleado = document.getElementById('id_empleado')
    const descuentos = document.getElementById('descuentos')
    const adiciones = document.getElementById('adiciones')
    const neto = document.getElementById('netoSueldo')
    const ayudaSueldo = document.getElementById('ayudaSueldo')
    const pesos = (n) => '$' + n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    function traerSueldo() {
      const opt = selEmpleado.selectedOptions[0]
      const sueldo = opt && opt.value ? Number(opt.dataset.sueldo || 0) : 0
      monto.value = sueldo > 0 ? sueldo : ''
      if (ayudaSueldo) {
        ayudaSueldo.textContent = opt && opt.value && !(sueldo > 0)
          ? 'Este empleado no tiene sueldo establecido: cargalo en su ficha o escribí el monto.'
          : 'Se completa con el sueldo establecido del empleado (podés cambiarlo).'
      }
      calcNeto()
    }
    function calcNeto() {
      if (cat.value !== 'sueldo') return
      const n = (parseFloat(monto.value) || 0) - (parseFloat(descuentos.value) || 0) + (parseFloat(adiciones.value) || 0)
      neto.value = pesos(n)
    }
    selEmpleado.addEventListener('change', traerSueldo)
    ;[monto, descuentos, adiciones].forEach(el => el.addEventListener('input', calcNeto))

    document.getElementById('formEgreso').addEventListener('submit', (e) => {
      if (cat.value !== 'sueldo') return
      if (!selEmpleado.value) { alert('Elegí el empleado al que se le paga el sueldo.'); e.preventDefault(); return }
      const n = (parseFloat(monto.value) || 0) - (parseFloat(descuentos.value) || 0) + (parseFloat(adiciones.value) || 0)
      if (n <= 0) { alert('El neto a pagar tiene que ser mayor a cero: revisá el sueldo y los descuentos.'); e.preventDefault() }
    })

    // El monto arranca bloqueado (se calcula solo) SOLO para material, que es la
    // única categoría con cálculo automático. Para el resto siempre es libre, como
    // antes. Tildando "Editar manualmente" se desbloquea sin perder lo ya calculado.
    const checkEditarMonto = document.getElementById('checkEditarMonto')
    function aplicarBloqueoMonto() {
      const esMaterial = cat.value === 'material'
      monto.readOnly = esMaterial && !checkEditarMonto?.checked
    }
    checkEditarMonto?.addEventListener('change', () => {
      aplicarBloqueoMonto()
      if (checkEditarMonto.checked) monto.focus()
    })
    toggle()

    // Material: monto = (cantidad × costo unitario) + flete (auto, mientras no se
    // tilde "Editar manualmente")
    function calcMaterial() {
      if (cat.value !== 'material' || checkEditarMonto?.checked) return
      const c = parseFloat(cantidad?.value) || 0
      const u = parseFloat(costo?.value) || 0
      const f = parseFloat(flete?.value) || 0
      if (c > 0 && (u > 0 || f > 0)) monto.value = (c * u + f).toFixed(2)
    }
    cantidad?.addEventListener('input', calcMaterial)
    costo?.addEventListener('input', calcMaterial)
    flete?.addEventListener('input', calcMaterial)

    // Buscador de proveedor
    const b = document.getElementById('buscarProv'), s = document.getElementById('selProv')
    if (b && s) b.addEventListener('input', () => {
      const q = b.value.trim().toLowerCase(); let first = ''
      Array.from(s.options).forEach(o => { if (!o.value) return; const hay = (o.dataset.search||'').includes(q); o.hidden = q && !hay; if (hay && !first) first = o.value })
      if (q && first) s.value = first
    })
  })()
</script>
