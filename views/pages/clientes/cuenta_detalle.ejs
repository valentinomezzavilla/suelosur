<%
  const money = (n) => '$' + Number(n || 0).toLocaleString('es-AR')
  const nombre = `${cliente.nombre} ${cliente.apellido || ''}`.trim()
  const tipoLabel = { deuda: 'Cargo', pago: 'Pago', ajuste: 'Ajuste', uso_saldo_favor: 'Uso saldo a favor' }
  const metodoLabel = { efectivo: 'Efectivo', transferencia: 'Transferencia', cheque: 'Cheque', echeq: 'Echeq', cuenta_corriente: 'Cta. corriente' }
  // Deudas = cargadas a cuenta corriente; uso de saldo a favor = pagado con crédito ya
  // acumulado (no genera deuda); pagos = método capturado; resto = —
  const metodoDe = (m) => m.tipo === 'deuda' ? 'Cta. corriente'
    : m.tipo === 'uso_saldo_favor' ? 'Saldo a favor'
    : (m.metodo_pago ? (metodoLabel[m.metodo_pago] || m.metodo_pago) : '—')
  const saldoTxt = (s) => s < 0 ? `Debe ${money(Math.abs(s))}` : (s > 0 ? `A favor ${money(s)}` : 'Al día')
  const saldoCls = (s) => s < 0 ? 'text-danger' : (s > 0 ? 'text-success' : 'text-muted')
  // Mismos parámetros que /liquidaciones (el PDF es la liquidación del cliente)
  const qsPdf = (() => {
    const p = new URLSearchParams()
    if (filtros.obra) p.set('obra', filtros.obra)
    p.set('desde', filtros.desde); p.set('hasta', filtros.hasta)
    filtros.tipos.forEach(t => p.append('tipos', t))
    p.set('estadoPago', filtros.estadoPago)
    return p.toString()
  })()
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <a href="/clientes/cuentas" class="text-muted small text-decoration-none">← Cuentas corrientes</a>
    <h4 class="fw-bold mb-0 text-dark-title">
      <%- icon('chart', { size: 18 }) %> Cuenta corriente — <%= nombre %>
    </h4>
  </div>
  <div class="d-flex gap-2">
    <a href="/clientes/cuentas/<%= cliente.id %>/pdf?<%= qsPdf %>" target="_blank" class="btn btn-sm btn-outline-secondary">
      <%- icon('printer', { size: 15 }) %> Descargar PDF
    </a>
    <% if (cliente.saldo < 0) { %>
      <button type="button" class="btn btn-success btn-abonar"
              data-id="<%= cliente.id %>" data-nombre="<%= nombre %>"
              data-deuda="<%= Math.abs(cliente.saldo) %>">Saldar deuda total</button>
    <% } %>
    <% if (cliente.cuenta_corriente) { %>
    <form action="/clientes/<%= cliente.id %>/deshabilitar-cuenta" method="POST" class="d-inline"
          onsubmit="return confirm('¿Deshabilitar la cuenta corriente de <%= nombre %>? No va a poder comprar a cuenta corriente. El historial y el saldo se conservan.')">
      <button type="submit" class="btn btn-sm btn-outline-danger">Deshabilitar cuenta</button>
    </form>
    <% } else { %>
    <form action="/clientes/<%= cliente.id %>/habilitar-cuenta" method="POST" class="d-inline">
      <button type="submit" class="btn btn-sm btn-success">+ Habilitar cuenta</button>
    </form>
    <% } %>
  </div>
</div>

<!-- Saldo actual -->
<div class="card shadow-sm mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <div class="text-muted small">Saldo actual</div>
      <div class="fs-4 fw-bold <%= saldoCls(cliente.saldo) %>"><%= saldoTxt(cliente.saldo) %></div>
    </div>
    <div class="text-end">
      <% if (cliente.cuenta_corriente) { %>
        <span class="badge rounded-pill px-3 badge-activo">Cuenta habilitada</span>
      <% } else { %>
        <span class="badge rounded-pill px-3 badge-alerta">Cuenta deshabilitada</span>
      <% } %>
    </div>
  </div>
</div>

<% if (sinCargo.length) { %>
<!-- Operaciones a cta. cte. que todavía no generaron cargo -->
<div class="card shadow-sm mb-3">
  <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
    <span>Operaciones a cuenta corriente en curso</span>
    <small class="text-muted">Todavía no suman al saldo: el cargo se genera al cerrarse</small>
  </div>
  <div class="card-body p-0">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Operación</th>
          <th>Detalle</th>
          <th>Estado</th>
          <th>Desde</th>
          <th class="text-end">Importe estimado a hoy</th>
          <th class="text-center">Cuándo se carga</th>
        </tr>
      </thead>
      <tbody>
        <% sinCargo.forEach(o => { %>
        <tr>
          <td class="fw-semibold text-orange">OP-<%= String(o.nro_op).padStart(4, '0') %></td>
          <td>
            <% if (o.tipo_op === 'C') { %>Alquiler contenedor<%= o.numero_contenedor ? ' #' + o.numero_contenedor : '' %>
            <% } else if (o.tipo_op === 'MA') { %>Alquiler <%= o.maquinaria_nombre || 'maquinaria' %>
            <% } else { %>Venta<% } %>
            <% if (o.obra) { %><small class="text-muted"> — <%= o.obra %></small><% } %>
          </td>
          <td><small class="text-muted"><%= { pendiente: 'Pendiente', despachado: 'Despachado', entregado: 'En curso' }[o.estado] || o.estado %></small></td>
          <td><small class="text-muted"><%= formatFecha(o.fecha_entrega_planificada || o.fecha_emision) %></small></td>
          <td class="text-end"><%= o.estimado != null ? money(o.estimado) : '—' %></td>
          <td class="text-center"><small class="text-muted"><%= o.tipo_op === 'MA' ? 'Al iniciar el trabajo' : 'Al cerrar el alquiler' %></small></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Filtros: los mismos que Liquidaciones -->
<div class="card shadow-sm mb-3">
  <div class="card-body">
    <form method="GET" action="/clientes/cuentas/<%= cliente.id %>">
      <div class="row g-2 align-items-end mb-2">
        <div class="col-12 col-md-5">
          <label class="form-label" for="filtroObra">Obra</label>
          <select name="obra" id="filtroObra" class="form-select" <%= obras.length ? '' : 'disabled' %>>
            <% if (!obras.length) { %>
              <option value="">El cliente no tiene obras cargadas</option>
            <% } else { %>
              <option value="">Todas las obras</option>
              <% obras.forEach(o => { %><option value="<%= o.clave %>" <%= filtros.obra === o.clave ? 'selected' : '' %>><%= o.nombre %></option><% }) %>
            <% } %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">Estado de pago</label>
          <select name="estadoPago" class="form-select">
            <option value="todas" <%= filtros.estadoPago === 'todas' ? 'selected' : '' %>>Todas</option>
            <option value="pendientes" <%= filtros.estadoPago === 'pendientes' ? 'selected' : '' %>>Solo pendientes</option>
            <option value="pagadas" <%= filtros.estadoPago === 'pagadas' ? 'selected' : '' %>>Solo pagadas</option>
          </select>
        </div>
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
          <label class="form-label">Desde</label>
          <input type="date" name="desde" class="form-control" value="<%= filtros.desde %>">
        </div>
        <div class="col-6 col-md-2">
          <label class="form-label">Hasta</label>
          <input type="date" name="hasta" class="form-control" value="<%= filtros.hasta %>">
        </div>
        <div class="col-12 col-md-5">
          <label class="form-label d-block">Operaciones</label>
          <div class="liq-tipos">
            <% Object.entries(TIPOS).forEach(([k, label]) => { %>
              <label class="liq-tipo"><input type="checkbox" name="tipos" value="<%= k %>" <%= filtros.tipos.includes(k) ? 'checked' : '' %>> <%= label %></label>
            <% }) %>
          </div>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Ver</button>
          <a href="/clientes/cuentas/<%= cliente.id %>" class="btn btn-outline-secondary">Limpiar</a>
        </div>
      </div>
      <p class="form-text mb-0 mt-2">Los movimientos de abajo se filtran por fechas y obra<% if (obra) { %> (con obra <strong><%= obra.nombre %></strong> se ven sus cargos y todos los pagos del cliente, que no están atados a una obra)<% } %>. Estado de pago y operaciones se aplican al PDF.</p>
    </form>
  </div>
</div>

<!-- Resumen del período -->
<div class="stat-cards" style="grid-template-columns:repeat(4,minmax(0,1fr))">
  <div class="stat-card stat-card--neutral">
    <div class="stat-card__body"><span class="stat-card__value"><%= money(estado.saldoInicial) %></span><span class="stat-card__label">Saldo inicial</span></div>
  </div>
  <div class="stat-card stat-card--danger">
    <div class="stat-card__body"><span class="stat-card__value"><%= money(estado.debitos) %></span><span class="stat-card__label">Débitos (cargos)</span></div>
  </div>
  <div class="stat-card stat-card--success">
    <div class="stat-card__body"><span class="stat-card__value"><%= money(estado.creditos) %></span><span class="stat-card__label">Créditos (pagos)</span></div>
  </div>
  <div class="stat-card stat-card--info">
    <div class="stat-card__body"><span class="stat-card__value <%= saldoCls(estado.saldoFinal) %>"><%= money(estado.saldoFinal) %></span><span class="stat-card__label">Saldo final · <%= periodoLabel %></span></div>
  </div>
</div>

<!-- Registrar movimiento -->
<div class="card shadow-sm mb-3">
  <div class="card-header bg-white fw-semibold">Registrar movimiento</div>
  <div class="card-body">
    <form action="/clientes/<%= cliente.id %>/cuenta/movimiento" method="POST">
      <div class="row g-2 align-items-end">
        <div class="col-md-2">
          <label class="form-label">Tipo</label>
          <select name="clase" class="form-select form-select-sm">
            <option value="pago">Pago / abono</option>
            <option value="cargo">Cargo / deuda</option>
            <option value="ajuste">Ajuste a favor</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Monto</label>
          <input type="number" name="monto" min="1" step="1" class="form-control form-control-sm" placeholder="Ej: 15000" required>
        </div>
        <div class="col-md-2">
          <label class="form-label">Método (si es pago)</label>
          <select name="metodo_pago" class="form-select form-select-sm">
            <option value="">—</option>
            <option value="efectivo">Efectivo</option>
            <option value="transferencia">Transferencia</option>
            <option value="cheque">Cheque</option><option value="echeq">Echeq</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Descripción</label>
          <input type="text" name="descripcion" class="form-control form-control-sm" placeholder="(opcional)">
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-sm btn-naranja">Registrar</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Ledger -->
<div class="card shadow-sm">
  <div class="card-header bg-white fw-semibold">Movimientos del período</div>
  <div class="card-body p-0">
    <% if (!estado.movimientos.length) { %>
      <div class="p-4 text-center text-muted">Sin movimientos en el período seleccionado.</div>
    <% } else { %>
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Tipo</th>
          <th>Descripción</th>
          <th>Método</th>
          <th class="text-end">Débito</th>
          <th class="text-end">Crédito</th>
          <th class="text-end">Saldo</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (filtros.desde) { %>
        <tr class="table-light">
          <td colspan="6" class="text-muted small">Saldo inicial</td>
          <td class="text-end fw-semibold <%= saldoCls(estado.saldoInicial) %>"><%= money(estado.saldoInicial) %></td>
          <td></td>
        </tr>
        <% } %>
        <% estado.movimientos.forEach(m => { %>
        <tr>
          <td><small class="text-muted"><%= formatFechaHora(m.created_at) %></small></td>
          <td>
            <% if (m.tipo === 'deuda') { %><span class="badge rounded-pill px-3 badge-alerta">Cargo</span>
            <% } else if (m.tipo === 'pago') { %><span class="badge rounded-pill px-3 badge-activo">Pago</span>
            <% } else if (m.tipo === 'uso_saldo_favor') { %><span class="badge rounded-pill px-3 badge-en-transito">Uso saldo a favor</span>
            <% } else { %><span class="badge rounded-pill px-3 badge-pendiente">Ajuste</span><% } %>
          </td>
          <td><%= m.descripcion %></td>
          <td><small class="text-muted"><%= metodoDe(m) %></small></td>
          <td class="text-end text-danger"><%= m.monto < 0 ? money(Math.abs(m.monto)) : '—' %></td>
          <td class="text-end text-success"><%= m.monto > 0 ? money(m.monto) : '—' %></td>
          <td class="text-end fw-semibold <%= saldoCls(m.saldo) %>"><%= money(m.saldo) %></td>
          <td class="text-center">
            <% if (m.tipo === 'deuda') { %>
              <%# Pagos aplicados FIFO: "Saldar" solo si a este cargo le falta algo,
                  y por lo que le falta (evita pagar dos veces lo mismo) %>
              <% const resta = pendientes[m.id] ?? Math.abs(m.monto) %>
              <% if (resta > 0.005) { %>
                <button type="button" class="btn btn-sm btn-outline-success btn-abonar"
                        data-id="<%= cliente.id %>" data-nombre="<%= nombre %>"
                        data-deuda="<%= resta %>" data-descripcion="<%= m.descripcion %>">
                  Saldar<%= resta < Math.abs(m.monto) - 0.005 ? ' ' + money(resta) : '' %>
                </button>
              <% } else if (Math.abs(m.monto) > 0.005) { %>
                <span class="badge rounded-pill px-3 badge-activo">Saldado</span>
              <% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="table-light">
          <td colspan="4" class="fw-semibold">Totales del período</td>
          <td class="text-end fw-bold text-danger"><%= money(estado.debitos) %></td>
          <td class="text-end fw-bold text-success"><%= money(estado.creditos) %></td>
          <td class="text-end fw-bold <%= saldoCls(estado.saldoFinal) %>"><%= money(estado.saldoFinal) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <% } %>
  </div>
</div>

<!-- Modal abonar -->
<div id="modal-abonar" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <div class="modal-header">
      <h2 class="modal-title">Saldar deuda — <span id="modal-abonar-nombre"></span></h2>
      <button type="button" class="modal-close" id="cerrarModalAbonar" aria-label="Cerrar">✕</button>
    </div>
    <div class="modal-body">
      <div class="abonar-resumen">
        <p class="abonar-resumen__label" id="modal-abonar-deuda-label">Deuda total</p>
        <div class="abonar-resumen__monto" id="modal-abonar-deuda"></div>
        <p id="modal-abonar-concepto" class="abonar-resumen__concepto d-none"></p>
      </div>
      <form id="formAbonar" method="POST">
        <input type="hidden" name="descripcion" id="inputDescripcionAbonar">
        <div class="form-group">
          <div class="d-flex justify-content-between align-items-center">
            <label for="inputMonto" class="mb-0">Monto a abonar</label>
            <button type="button" class="abonar-quickfill" id="btnPagarTotal">Usar el total</button>
          </div>
          <div class="abonar-input-monto">
            <input type="number" name="monto" id="inputMonto" min="1" step="1" required placeholder="0" inputmode="numeric">
          </div>
        </div>
        <div class="form-group">
          <label for="inputMetodoAbonar">Método de pago</label>
          <select name="metodo_pago" id="inputMetodoAbonar">
            <option value="efectivo">Efectivo</option>
            <option value="transferencia">Transferencia</option>
            <option value="cheque">Cheque</option><option value="echeq">Echeq</option>
          </select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-outline-secondary" id="cancelarModalAbonar">Cancelar</button>
          <button type="submit" class="btn btn-success">Confirmar pago</button>
        </div>
      </form>
    </div>
  </div>
</div>
