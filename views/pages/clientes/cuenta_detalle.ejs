<%
  const money = (n) => '$' + Number(n || 0).toLocaleString('es-AR')
  const nombre = `${cliente.nombre} ${cliente.apellido || ''}`.trim()
  const tipoLabel = { deuda: 'Cargo', pago: 'Pago', ajuste: 'Ajuste', uso_saldo_favor: 'Uso saldo a favor' }
  const metodoLabel = { efectivo: 'Efectivo', transferencia: 'Transferencia', cheque: 'Cheque', echeq: 'Echeq', cuenta_corriente: 'Cta. corriente' }
  // Deudas = cargadas a cuenta corriente; uso de saldo a favor = pagado con crédito ya
  // acumulado (no genera deuda); pagos = método capturado; resto = —
  const metodoDe = (m) => m.tipo === 'deuda' ? 'Cta. corriente'
    : m.tipo === 'uso_saldo_favor' ? 'Saldo a favor'
    : (m.metodo_pago ? (metodoLabel[m.metodo_pago] || m.metodo_pago) : '—')
  const saldoTxt = (s) => s < 0 ? `Debe ${money(Math.abs(s))}` : (s > 0 ? `A favor ${money(s)}` : 'Al día')
  const saldoCls = (s) => s < 0 ? 'text-danger' : (s > 0 ? 'text-success' : 'text-muted')
  // Anular pagos: solo dueño y administración contable
  const puedeAnular = !!user && ['dueno', 'admin_contable'].includes(user.rol)
  // Mismos parámetros que /liquidaciones (el PDF es la liquidación del cliente)
  const qsPdf = (() => {
    const p = new URLSearchParams()
    if (filtros.obra) p.set('obra', filtros.obra)
    p.set('desde', filtros.desde); p.set('hasta', filtros.hasta)
    filtros.tipos.forEach(t => p.append('tipos', t))
    p.set('estadoPago', filtros.estadoPago)
    return p.toString()
  })()
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <a href="/clientes/cuentas" class="text-muted small text-decoration-none">← Cuentas corrientes</a>
    <h4 class="fw-bold mb-0 text-dark-title">
      <%- icon('chart', { size: 18 }) %> Cuenta corriente — <%= nombre %>
    </h4>
  </div>
  <div class="d-flex gap-2">
    <a href="/clientes/cuentas/<%= cliente.id %>/pdf?<%= qsPdf %>" target="_blank" class="btn btn-sm btn-outline-secondary">
      <%- icon('printer', { size: 15 }) %> Descargar PDF
    </a>
    <a href="/liquidaciones?<%= new URLSearchParams(Object.assign({ clienteId: String(cliente.id) }, filtros.desde ? { desde: filtros.desde } : {}, filtros.hasta ? { hasta: filtros.hasta } : {})).toString() %>"
       class="btn btn-sm btn-outline-secondary" title="Las operaciones del período con su detalle, y por qué el saldo puede ser distinto">
      <%- icon('fileText', { size: 15 }) %> Ver liquidación del período
    </a>
    <%# Registrar un pago: se elige a qué operaciones se aplica (también un adelanto, sin deuda) %>
    <button type="button" class="btn btn-success btn-abonar"
            data-id="<%= cliente.id %>" data-nombre="<%= nombre %>"
            data-deuda="<%= Math.max(0, -Number(cliente.saldo) || 0) %>">Registrar pago</button>
    <% if (cliente.cuenta_corriente) { %>
    <form action="/clientes/<%= cliente.id %>/deshabilitar-cuenta" method="POST" class="d-inline"
          onsubmit="return confirm('¿Deshabilitar la cuenta corriente de <%= nombre %>? No va a poder comprar a cuenta corriente. El historial y el saldo se conservan.')">
      <button type="submit" class="btn btn-sm btn-outline-danger">Deshabilitar cuenta</button>
    </form>
    <% } else { %>
    <form action="/clientes/<%= cliente.id %>/habilitar-cuenta" method="POST" class="d-inline">
      <button type="submit" class="btn btn-sm btn-success">+ Habilitar cuenta</button>
    </form>
    <% } %>
  </div>
</div>

<!-- Saldo del cliente: el mismo bloque y los mismos números que su Liquidación -->
<div class="d-flex justify-content-end mb-2">
  <% if (cliente.cuenta_corriente) { %>
    <span class="badge rounded-pill px-3 badge-activo">Cuenta habilitada</span>
  <% } else { %>
    <span class="badge rounded-pill px-3 badge-alerta">Cuenta deshabilitada</span>
  <% } %>
</div>
<%- include('../../partials/saldo_cliente', { saldo, idCliente: cliente.id }) %>

<!-- Filtros: los mismos que Liquidaciones -->
<div class="card shadow-sm mb-3">
  <div class="card-body">
    <form method="GET" action="/clientes/cuentas/<%= cliente.id %>">
      <div class="row g-2 align-items-end mb-2">
        <div class="col-12 col-md-5">
          <label class="form-label" for="filtroObra">Obra</label>
          <select name="obra" id="filtroObra" class="form-select" <%= obras.length ? '' : 'disabled' %>>
            <% if (!obras.length) { %>
              <option value="">El cliente no tiene obras cargadas</option>
            <% } else { %>
              <option value="">Todas las obras</option>
              <% obras.forEach(o => { %><option value="<%= o.clave %>" <%= filtros.obra === o.clave ? 'selected' : '' %>><%= o.nombre %></option><% }) %>
            <% } %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">Estado de pago</label>
          <select name="estadoPago" class="form-select">
            <option value="todas" <%= filtros.estadoPago === 'todas' ? 'selected' : '' %>>Todas</option>
            <option value="pendientes" <%= filtros.estadoPago === 'pendientes' ? 'selected' : '' %>>Solo pendientes</option>
            <option value="pagadas" <%= filtros.estadoPago === 'pagadas' ? 'selected' : '' %>>Solo pagadas</option>
          </select>
        </div>
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
          <label class="form-label">Desde</label>
          <input type="date" name="desde" class="form-control" value="<%= filtros.desde %>">
        </div>
        <div class="col-6 col-md-2">
          <label class="form-label">Hasta</label>
          <input type="date" name="hasta" class="form-control" value="<%= filtros.hasta %>">
        </div>
        <div class="col-12 col-md-5">
          <label class="form-label d-block">Operaciones</label>
          <div class="liq-tipos">
            <% Object.entries(TIPOS).forEach(([k, label]) => { %>
              <label class="liq-tipo"><input type="checkbox" name="tipos" value="<%= k %>" <%= filtros.tipos.includes(k) ? 'checked' : '' %>> <%= label %></label>
            <% }) %>
          </div>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Ver</button>
          <a href="/clientes/cuentas/<%= cliente.id %>" class="btn btn-outline-secondary">Limpiar</a>
        </div>
      </div>
      <p class="form-text mb-0 mt-2">Los movimientos de abajo se filtran por fechas y obra<% if (obra) { %> (con obra <strong><%= obra.nombre %></strong> se ven sus cargos y todos los pagos del cliente, que no están atados a una obra)<% } %>. Estado de pago y operaciones se aplican al PDF.</p>
    </form>
  </div>
</div>

<!-- Resumen del período -->
<div class="stat-cards" style="grid-template-columns:repeat(4,minmax(0,1fr))">
  <div class="stat-card stat-card--neutral">
    <div class="stat-card__body"><span class="stat-card__value <%= saldoCls(estado.saldoInicial) %>"><%= saldoTxt(estado.saldoInicial) %></span><span class="stat-card__label">Saldo inicial</span></div>
  </div>
  <div class="stat-card stat-card--danger">
    <div class="stat-card__body"><span class="stat-card__value"><%= money(estado.debitos) %></span><span class="stat-card__label">Débitos (cargos)</span></div>
  </div>
  <div class="stat-card stat-card--success">
    <div class="stat-card__body"><span class="stat-card__value"><%= money(estado.creditos) %></span><span class="stat-card__label">Créditos (pagos)</span></div>
  </div>
  <div class="stat-card stat-card--info">
    <div class="stat-card__body"><span class="stat-card__value <%= saldoCls(estado.saldoFinal) %>"><%= saldoTxt(estado.saldoFinal) %></span><span class="stat-card__label">Saldo final · <%= periodoLabel %></span></div>
  </div>
</div>

<!-- Cargo o ajuste a mano (los pagos se registran con "Registrar pago", donde se elige qué operaciones pagan) -->
<div class="card shadow-sm mb-3">
  <div class="card-header bg-white fw-semibold">Cargo o ajuste a mano</div>
  <div class="card-body">
    <form action="/clientes/<%= cliente.id %>/cuenta/movimiento" method="POST">
      <div class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label" for="claseMovimiento">Tipo</label>
          <select name="clase" id="claseMovimiento" class="form-select form-select-sm">
            <option value="cargo">Cargo / deuda</option>
            <option value="ajuste">Ajuste a favor</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="montoMovimiento">Monto</label>
          <input type="number" name="monto" id="montoMovimiento" min="0.01" step="0.01" class="form-control form-control-sm" placeholder="Ej: 15000" required>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="fechaMovimiento">Fecha</label>
          <input type="date" name="fecha" id="fechaMovimiento" class="form-control form-control-sm" value="<%= hoyISO() %>" max="<%= hoyISO() %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="descMovimiento">Descripción</label>
          <input type="text" name="descripcion" id="descMovimiento" class="form-control form-control-sm" placeholder="(opcional)">
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-sm btn-naranja">Registrar</button>
        </div>
      </div>
      <p class="form-hint mb-0 mt-2">Para registrar un pago del cliente usá <strong>Registrar pago</strong> (arriba) o <strong>Saldar</strong> en una operación: ahí se elige a qué operaciones se aplica.</p>
    </form>
  </div>
</div>

<!-- Ledger -->
<div class="card shadow-sm">
  <div class="card-header bg-white fw-semibold">Movimientos del período</div>
  <div class="card-body p-0">
    <% if (!estado.movimientos.length) { %>
      <div class="p-4 text-center text-muted">Sin movimientos en el período seleccionado.</div>
    <% } else { %>
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Tipo</th>
          <th>Descripción</th>
          <th>Método</th>
          <th class="text-end">Débito</th>
          <th class="text-end">Crédito</th>
          <th class="text-end">Saldo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (filtros.desde) { %>
        <tr class="table-light">
          <td colspan="6" class="text-muted small">Saldo inicial</td>
          <td class="text-end fw-semibold <%= saldoCls(estado.saldoInicial) %>"><%= money(estado.saldoInicial) %></td>
          <td></td>
        </tr>
        <% } %>
        <% const saldarMostrado = new Set() %>
        <% const pendienteMostrado = new Set() %>
        <% const nroFacturaMostrado = new Set() %>
        <% estado.movimientos.forEach(m => { %>
        <% const anulado = !!Number(m.anulado) %>
        <tr class="<%= anulado ? 'mov-anulado' : '' %>">
          <td>
            <small class="text-muted"><%= formatFechaHora(m.created_at) %></small>
            <% if (m.registrado_en && String(m.registrado_en).slice(0, 10) !== String(m.created_at).slice(0, 10)) { %>
              <div class="small text-muted" title="Día en que se cargó en el sistema">Cargado el <%= formatFecha(m.registrado_en) %></div>
            <% } %>
          </td>
          <td>
            <% if (anulado) { %><span class="badge rounded-pill px-3 badge-alerta" title="Anulado el <%= formatFechaHora(m.anulado_en) %>: <%= m.anulado_motivo %>">Pago anulado</span>
            <% } else if (m.tipo === 'deuda') { %><span class="badge rounded-pill px-3 badge-alerta">Cargo</span>
            <% } else if (m.tipo === 'pago') { %><span class="badge rounded-pill px-3 badge-activo">Pago</span>
            <% } else if (m.tipo === 'uso_saldo_favor') { %><span class="badge rounded-pill px-3 badge-en-transito">Uso saldo a favor</span>
            <% } else { %><span class="badge rounded-pill px-3 badge-pendiente">Ajuste</span><% } %>
          </td>
          <td>
            <%= m.descripcion %>
            <% if (anulado) { %><div class="small text-danger">Anulado el <%= formatFechaHora(m.anulado_en) %> — <%= m.anulado_motivo %></div><% } %>
            <%# A qué se aplicó el pago (lo elegido al registrarlo y, si no, lo más antiguo) y lo que quedó a favor %>
            <% if (!anulado && m.monto > 0) {
                 const ap = aplicadoA[m.id] || []
                 const sobra = aFavorPorPago[m.id] || 0 %>
              <% if (ap.length) { %><div class="small text-muted">Aplicado a: <%= ap.map(a => `${a.etiqueta} ${money(a.monto)}`).join(' · ') %></div><% } %>
              <% if (sobra > 0.005) { %><div class="small text-success">Quedan a favor: <%= money(sobra) %></div><% } %>
            <% } %>
          </td>
          <td><small class="text-muted"><%= metodoDe(m) %></small></td>
          <td class="text-end text-danger"><span class="<%= anulado ? 'text-decoration-line-through' : '' %>"><%= m.monto < 0 ? money(Math.abs(m.monto)) : '—' %></span></td>
          <td class="text-end text-success"><span class="<%= anulado ? 'text-decoration-line-through text-muted' : '' %>"><%= m.monto > 0 ? money(m.monto) : '—' %></span></td>
          <td class="text-end fw-semibold <%= anulado ? 'text-muted' : saldoCls(m.saldo) %>"><%= anulado ? '—' : money(m.saldo) %></td>
          <td class="text-center">
            <div class="acciones-fila">
            <% if (m.tipo === 'pago' && !anulado && puedeAnular) { %>
              <form action="/clientes/<%= cliente.id %>/cuenta/movimiento/<%= m.id %>/anular" method="POST" class="d-inline form-anular-pago"
                    data-monto="<%= money(m.monto) %>">
                <input type="hidden" name="motivo">
                <%- include('../../partials/btn_icono', { icono: 'ban', etiqueta: 'Anular este pago', clase: 'btn-outline-danger', tipo: 'submit' }) %>
              </form>
            <% } %>
            <% if (m.tipo === 'deuda') { %>
              <%# "Saldar" por operación: exactamente lo que le falta (todos sus cargos juntos, p. ej.
                  con el IVA) y el pago se aplica a ella. Una vez por operación. %>
              <% const sd = saldarPorCargo[m.id] %>
              <% if (sd && !saldarMostrado.has(sd.clave)) { saldarMostrado.add(sd.clave) %>
                <%- include('../../partials/btn_icono', { icono: 'checkCircle', clase: 'btn-outline-success btn-abonar',
                      etiqueta: 'Marcar como pagada' + (sd.resta < sd.total - 0.005 ? ' ' + money(sd.resta) : ''),
                      attrs: { 'data-id': cliente.id, 'data-nombre': nombre, 'data-clave': sd.clave, 'data-deuda': sd.resta, 'data-descripcion': m.descripcion } }) %>
              <% } else if (sd) { %>
                <small class="text-muted">Se salda con su operación</small>
              <% } else if (Math.abs(m.monto) > 0.005 && !((pendientes[m.id] || 0) > 0.005)) { %>
                <span class="badge rounded-pill px-3 badge-activo">Saldado</span>
              <% } %>
              <%# Marcar pendiente: una vez por operación, si tiene algo pagado (quita los pagos aplicados y el saldo acompaña) %>
              <% if (puedeAnular && m.id_op_encabezado && !pendienteMostrado.has(String(m.id_op_encabezado)) && (!sd || sd.resta < sd.total - 0.005)) { pendienteMostrado.add(String(m.id_op_encabezado)) %>
                <%- include('../../partials/btn_icono', { icono: 'clock', etiqueta: 'Marcar pendiente', clase: 'btn-outline-danger btn-estado-pago',
                      attrs: { 'data-id': m.id_op_encabezado, 'data-accion': 'pendiente', 'data-nombre': m.descripcion } }) %>
              <% } %>
              <%# Agregar / editar el N° de factura (public/js/nroFactura.js): una vez por operación; la facturada y la anulada no lo llevan %>
              <% const opNro = m.id_op_encabezado ? (locals.opsNroFactura || {})[m.id_op_encabezado] : null %>
              <% if (opNro && !nroFacturaMostrado.has(String(m.id_op_encabezado))) { nroFacturaMostrado.add(String(m.id_op_encabezado)) %>
                <%- include('../../partials/boton_nro_factura', { op: opNro }) %>
              <% } %>
            <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="table-light">
          <td colspan="4" class="fw-semibold">Totales del período</td>
          <td class="text-end fw-bold text-danger"><%= money(estado.debitos) %></td>
          <td class="text-end fw-bold text-success"><%= money(estado.creditos) %></td>
          <td class="text-end fw-bold <%= saldoCls(estado.saldoFinal) %>"><%= money(estado.saldoFinal) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <% } %>
  </div>
</div>

<!-- Modal de pago (elige a qué operaciones se aplica) -->
<%- include('../../partials/modal_pago_cuenta') %>
<!-- Marcar pendiente una operación (con vista previa de lo que cambia) -->
<%- include('../../partials/modal_estado_pago') %>
<!-- Agregar / editar el N° de factura de una operación -->
<%- include('../../partials/modal_nro_factura') %>

<script>
// Anular pago: confirma y pide el motivo (queda registrado en el historial)
document.querySelectorAll('.form-anular-pago').forEach(function (form) {
  form.addEventListener('submit', function (e) {
    var motivo = prompt('¿Anular el pago de ' + form.dataset.monto + '? Se descuenta del saldo del cliente y las operaciones que cubría vuelven a quedar pendientes.\n\nMotivo de la anulación:')
    if (motivo === null) { e.preventDefault(); return }
    motivo = motivo.trim()
    if (!motivo) { e.preventDefault(); alert('Tenés que indicar el motivo.'); return }
    form.querySelector('[name=motivo]').value = motivo
  })
})
</script>
