<%
  const money = (n) => '$' + Number(n || 0).toLocaleString('es-AR')
  const totalDeuda  = conCuenta.filter(c => c.saldo < 0).reduce((a, c) => a + Math.abs(c.saldo), 0)
  const totalAFavor = conCuenta.filter(c => c.saldo > 0).reduce((a, c) => a + c.saldo, 0)
  const conDeuda    = conCuenta.filter(c => c.saldo < 0).length
  const hayFiltros  = !!(filtros.q || filtros.saldo || filtros.estado || filtros.tipo || filtros.enCurso)
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0 text-dark-title"><%- icon('chart', { size: 18 }) %> Cuentas corrientes</h4>
  <a href="/clientes" class="btn btn-sm btn-outline-secondary">← Clientes</a>
</div>

<%- include('../../partials/tabla_toolbar', {
  action: '/clientes/cuentas',
  placeholder: 'Buscar cliente por #, nombre, DNI/CUIT o teléfono...',
  qValue: filtros.q,
  hiddenFilters: { sort: filtros.sort, dir: filtros.sort ? filtros.dir : '' },
  filtros: [
    { name: 'saldo', label: 'Saldo', selected: filtros.saldo, options: [
      { value: 'deuda', label: 'Con deuda' },
      { value: 'favor', label: 'Con saldo a favor' },
      { value: 'aldia', label: 'Al día' },
    ]},
    { name: 'estado', label: 'Cuenta', selected: filtros.estado, options: [
      { value: 'habilitada', label: 'Habilitada' },
      { value: 'deshabilitada', label: 'Deshabilitada' },
    ]},
    { name: 'tipo', label: 'Tipo de cliente', selected: filtros.tipo, options: tiposCliente.map(t => ({ value: t, label: t })) },
    { name: 'enCurso', label: 'Operaciones en curso', selected: filtros.enCurso, options: [
      { value: 'si', label: 'Con alquileres en curso' },
    ]},
  ],
}) %>

<!-- Resultados: se reemplazan en vivo al tipear en el buscador (js/cuentasBusqueda.js) -->
<div id="cuentasResultados">
<!-- Métricas (sobre las cuentas filtradas) -->
<div class="stat-cards" style="grid-template-columns:repeat(3,minmax(0,1fr));max-width:760px">
  <div class="stat-card stat-card--danger">
    <div class="stat-card__icon"><%- icon('alert', { size: 20 }) %></div>
    <div class="stat-card__body"><span class="stat-card__value"><%= money(totalDeuda) %></span><span class="stat-card__label">Deuda total · <%= conDeuda %> cliente(s)</span></div>
  </div>
  <div class="stat-card stat-card--success">
    <div class="stat-card__icon"><%- icon('checkCircle', { size: 20 }) %></div>
    <div class="stat-card__body"><span class="stat-card__value"><%= money(totalAFavor) %></span><span class="stat-card__label">Saldo a favor</span></div>
  </div>
  <div class="stat-card stat-card--info">
    <div class="stat-card__icon"><%- icon('users', { size: 20 }) %></div>
    <div class="stat-card__body"><span class="stat-card__value"><%= conCuenta.filter(c => c.cuenta_corriente).length %></span><span class="stat-card__label">Cuentas habilitadas</span></div>
  </div>
</div>

<!-- Cuentas: habilitadas + cualquiera con saldo u operaciones a cta. cte. abiertas -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
    <span>Cuentas corrientes</span>
    <% if (hayFiltros) { %><small class="text-muted fw-normal">Mostrando <%= conCuenta.length %> de <%= totalCuentas %></small><% } %>
  </div>
  <div class="card-body p-0">
    <% if (!conCuenta.length && hayFiltros) { %>
      <%- include('../../partials/empty_state', { icono: '🔍', mensaje: 'Ninguna cuenta coincide con los filtros.', accionHref: '/clientes/cuentas', accionLabel: 'Limpiar filtros' }) %>
    <% } else if (!conCuenta.length) { %>
      <%- include('../../partials/empty_state', { icono: '💳', mensaje: 'No hay cuentas corrientes habilitadas aún.', accionHref: '/clientes', accionLabel: 'Ir a clientes' }) %>
    <% } else { %>
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <%- include('../../partials/th_sort', { sortKey: 'numero',      sortLabel: '#',       currentSort: filtros.sort, currentDir: filtros.dir, filtros, thClass: 'col-w-50' }) %>
          <%- include('../../partials/th_sort', { sortKey: 'cliente',     sortLabel: 'Cliente', currentSort: filtros.sort, currentDir: filtros.dir, filtros }) %>
          <th>Teléfono</th>
          <%- include('../../partials/th_sort', { sortKey: 'saldo',       sortLabel: 'Saldo',   currentSort: filtros.sort, currentDir: filtros.dir, filtros, align: 'end' }) %>
          <%- include('../../partials/th_sort', { sortKey: 'movimientos', sortLabel: 'Movim.',  currentSort: filtros.sort, currentDir: filtros.dir, filtros, align: 'center' }) %>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% conCuenta.forEach(c => { %>
        <tr>
          <td class="fw-semibold text-orange">#<%= c.numero %></td>
          <td class="fw-semibold">
            <%= c.nombre %> <%= c.apellido %>
            <% if (!c.cuenta_corriente) { %>
              <span class="badge rounded-pill badge-alerta ms-1" title="Tiene saldo u operaciones a cuenta corriente, pero la cuenta está deshabilitada">Deshabilitada</span>
            <% } %>
            <% if (c.cant_pendientes) { %>
              <span class="badge rounded-pill badge-pendiente ms-1" title="Alquileres a cuenta corriente en curso: el cargo se genera al cerrar"><%= c.cant_pendientes %> en curso</span>
            <% } %>
          </td>
          <td><small class="text-muted"><%= c.telefono || '—' %></small></td>
          <td class="text-end">
            <% if (c.saldo < 0) { %>
              <span class="fw-bold text-danger">Debe $<%= Math.abs(c.saldo).toLocaleString('es-AR') %></span>
            <% } else if (c.saldo > 0) { %>
              <span class="fw-bold text-success">A favor $<%= c.saldo.toLocaleString('es-AR') %></span>
            <% } else { %>
              <span class="badge rounded-pill px-3 badge-activo">Al día</span>
            <% } %>
          </td>
          <td class="text-center"><small class="text-muted"><%= c.cant_movimientos %></small></td>
          <td class="text-center">
            <a href="/clientes/cuentas/<%= c.id %>" class="btn btn-sm btn-outline-secondary">Estado de cuenta</a>
            <% if (c.saldo < 0) { %>
              <button type="button" class="btn btn-sm btn-success btn-abonar"
                      data-id="<%= c.id %>" data-nombre="<%= c.nombre %> <%= c.apellido %>"
                      data-deuda="<%= Math.abs(c.saldo) %>">Saldar</button>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<!-- Habilitar cuenta a clientes sin CC -->
<div class="card shadow-sm">
  <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
    <span>Habilitar cuenta corriente</span>
    <small class="text-muted">Clientes sin cuenta habilitada</small>
  </div>
  <div class="card-body p-0">
    <% if (!sinCuenta.length && filtros.q) { %>
      <div class="p-4 text-center text-muted">Ningún cliente sin cuenta coincide con "<%= filtros.q %>".</div>
    <% } else if (!sinCuenta.length) { %>
      <div class="p-4 text-center text-muted">Todos los clientes activos ya tienen cuenta corriente habilitada.</div>
    <% } else { %>
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th class="col-w-50">#</th>
          <th>Cliente</th>
          <th>Teléfono</th>
          <th>Email</th>
          <th class="text-center">Acción</th>
        </tr>
      </thead>
      <tbody>
        <% sinCuenta.forEach(c => { %>
        <tr>
          <td class="fw-semibold text-orange">#<%= c.numero %></td>
          <td class="fw-semibold"><%= c.nombre %> <%= c.apellido %></td>
          <td><small class="text-muted"><%= c.telefono || '—' %></small></td>
          <td><small class="text-muted"><%= c.email || '—' %></small></td>
          <td class="text-center">
            <form action="/clientes/<%= c.id %>/habilitar-cuenta" method="POST" class="d-inline">
              <button type="submit" class="btn btn-sm btn-success">+ Habilitar</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

</div>

<!-- Modal de pago (elige a qué operaciones se aplica) -->
<%- include('../../partials/modal_pago_cuenta') %>
