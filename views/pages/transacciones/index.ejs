<main id="transacciones-page">

            <%
                const tipoCorto = { 'Venta Cantera':'Cantera', 'Venta Viaje':'Viaje', 'Alquiler':'Contenedor', 'Maquinaria':'Máquina', 'Ajuste':'Ajuste' }
                const metodoTexto = { efectivo: 'Efectivo', transferencia: 'Transferencia', cheque: 'Cheque', echeq: 'Echeq', cuenta_corriente: 'Cuenta corriente', saldo_a_favor: 'Saldo a favor' }
                const m = metricas || { entradas: 0, salidas: 0, neto: 0, aCuenta: 0, cantidad: 0, conteo: {} }
                const money = (n) => '$' + Number(n||0).toLocaleString('es-AR')
                const puedeCorregir = ['dueno','admin_contable'].includes(user?.rol)
                // Enlace que conserva los filtros y cambia los que se pasan
                const conFiltros = (cambios) => {
                    const o = Object.assign({}, filtros, cambios)
                    const limpio = Object.entries(o).filter(([k, v]) => v !== '' && v != null && k !== 'sortBy' && k !== 'sortDir' && !(k === 'categoria' && v === 'todas'))
                    return '/transacciones?' + new URLSearchParams(limpio).toString()
                }
                const presetHref = (p) => conFiltros({ preset: p, fechaDesde: '', fechaHasta: '', mes: '' })
                // El reporte usa los mismos filtros que la tabla (sin la página ni el orden)
                const qsReporte = new URLSearchParams(Object.entries(filtros).filter(([k, v]) => v !== '' && v != null && k !== 'sortBy' && k !== 'sortDir')).toString()
            %>

            <div class="page-header">
                <h1 class="page-title"><%- icon('receipt', { size: 18 }) %> Transacciones</h1>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/transacciones/export/pdf?<%= qsReporte %>" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener"
                       title="Reporte PDF con los filtros aplicados"><%- icon('fileText', { size: 14 }) %> Reporte PDF</a>
                    <a href="/transacciones/export/excel?<%= qsReporte %>" class="btn btn-outline-secondary btn-sm"
                       title="Reporte Excel con los filtros aplicados"><%- icon('download', { size: 14 }) %> Excel</a>
                </div>
            </div>
            <p class="mov-ayuda">Todo el movimiento de plata: lo que <strong>entra</strong> (ventas, alquileres, pagos de clientes) y lo que <strong>sale</strong> (sueldos, compras y gastos). La fecha de cada renglón es la <strong>fecha de pago</strong>.</p>

            <!-- Qué mostrar: un botón por tipo -->
            <nav class="mov-chips" aria-label="Qué transacciones ver">
                <% categorias.forEach(c => { const activa = (filtros.categoria || 'todas') === c.clave %>
                    <a href="<%= conFiltros({ categoria: c.clave, page: '' }) %>" class="mov-chip <%= activa ? 'is-active' : '' %>" <%= activa ? 'aria-current=true' : '' %>>
                        <span><%= c.etiqueta %></span>
                        <span class="mov-chip__n"><%= (m.conteo || {})[c.clave] || 0 %></span>
                    </a>
                <% }) %>
            </nav>

            <!-- Métricas de lo que se está viendo -->
            <div class="stat-cards">
                <div class="stat-card stat-card--success">
                    <div class="stat-card__icon"><%- icon('arrowDown', { size: 20 }) %></div>
                    <div class="stat-card__body"><span class="stat-card__value"><%= money(m.entradas) %></span><span class="stat-card__label">Entró · <%= periodoLabel %></span></div>
                </div>
                <div class="stat-card stat-card--danger">
                    <div class="stat-card__icon"><%- icon('arrowUp', { size: 20 }) %></div>
                    <div class="stat-card__body"><span class="stat-card__value"><%= money(m.salidas) %></span><span class="stat-card__label">Salió · <%= periodoLabel %></span></div>
                </div>
                <div class="stat-card stat-card--neutral">
                    <div class="stat-card__icon"><%- icon('chart', { size: 20 }) %></div>
                    <div class="stat-card__body"><span class="stat-card__value <%= m.neto < 0 ? 'text-danger' : '' %>"><%= m.neto < 0 ? '−' + money(Math.abs(m.neto)) : money(m.neto) %></span><span class="stat-card__label">Neto (entró − salió)</span></div>
                </div>
                <div class="stat-card stat-card--warning">
                    <div class="stat-card__icon"><%- icon('clipboard', { size: 20 }) %></div>
                    <div class="stat-card__body"><span class="stat-card__value"><%= money(m.aCuenta) %></span><span class="stat-card__label" title="Ventas y alquileres a cuenta corriente: no es plata cobrada. Cuando el cliente paga, aparece en Pagos de clientes.">Vendido a cuenta corriente</span></div>
                </div>
            </div>

            <!-- Presets de período -->
            <div class="periodo-chips">
                <a href="<%= presetHref('hoy') %>"    class="periodo-chip <%= filtros.preset==='hoy'    ? 'is-active' : '' %>">Hoy</a>
                <a href="<%= presetHref('semana') %>" class="periodo-chip <%= filtros.preset==='semana' ? 'is-active' : '' %>">Esta semana</a>
                <a href="<%= presetHref('mes') %>"    class="periodo-chip <%= filtros.preset==='mes'    ? 'is-active' : '' %>">Este mes</a>
            </div>

            <!-- Filtros -->
            <form method="GET" action="/transacciones" class="filtros-bar filtros-bar--extended">
                <input type="hidden" name="preset" value="rango">
                <% if (filtros.categoria && filtros.categoria !== 'todas') { %><input type="hidden" name="categoria" value="<%= filtros.categoria %>"><% } %>
                <% if (filtros.tipo && filtros.tipo !== 'todos') { %><input type="hidden" name="tipo" value="<%= filtros.tipo %>"><% } %>
                <div class="filtro-group">
                    <label>Cliente / persona</label>
                    <input type="text" name="cliente" value="<%= filtros.cliente %>" list="listaClientesTx"
                        placeholder="Nombre del cliente, empleado o proveedor..." autocomplete="off">
                    <datalist id="listaClientesTx">
                        <% (clientesLista || []).forEach(c => { %>
                            <option value="<%= [c.nombre, c.apellido].filter(Boolean).join(' ') %>"><%= c.dni ? 'DNI ' + c.dni : '' %> <%= c.numero ? '· #' + c.numero : '' %></option>
                        <% }) %>
                    </datalist>
                </div>
                <div class="filtro-group">
                    <label>Remito</label>
                    <input type="text" name="remito" value="<%= filtros.remito %>" inputmode="numeric"
                        maxlength="8" placeholder="N° de remito..." autocomplete="off">
                </div>
                <div class="filtro-group">
                    <label>N° de OP</label>
                    <input type="text" name="nroOp" value="<%= filtros.nroOp %>" maxlength="10"
                        placeholder="Ej: 308 u OP-0308" autocomplete="off">
                </div>
                <div class="filtro-group">
                    <label>Pagado desde</label>
                    <input type="date" name="fechaDesde" value="<%= filtros.fechaDesde %>">
                </div>
                <div class="filtro-group">
                    <label>Pagado hasta</label>
                    <input type="date" name="fechaHasta" value="<%= filtros.fechaHasta %>">
                </div>
                <div class="filtro-group">
                    <label>Monto mín.</label>
                    <input type="number" name="montoMin" value="<%= filtros.montoMin %>" placeholder="0" min="0">
                </div>
                <div class="filtro-group">
                    <label>Monto máx.</label>
                    <input type="number" name="montoMax" value="<%= filtros.montoMax %>" placeholder="Sin límite"
                        min="0">
                </div>
                <button type="submit" class="btn-primary">Filtrar</button>
                <a href="/transacciones" class="btn-secondary">Limpiar</a>
            </form>

            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Fecha de pago</th>
                            <th>Tipo</th>
                            <th>Cliente / persona</th>
                            <th>Descripción</th>
                            <th>Método</th>
                            <th class="text-end">Monto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (movimientos.length === 0) { %>
                            <tr>
                                <td colspan="8" class="td-vacia">No hay transacciones que coincidan con los filtros</td>
                            </tr>
                        <% } %>
                        <% movimientos.forEach(t => {
                            const esTx = t.origen === 'transaccion'
                            const sinSaldar = esTx && t.metodo_pago === 'cuenta_corriente' && t.saldada === false
                            const cargadoOtroDia = t.cargado_en && String(t.cargado_en).slice(0, 10) !== String(t.fecha || '').slice(0, 10)
                            const tipoTxt = esTx ? (tipoCorto[t.tipo] || t.tipo) : (t.origen === 'pago_cliente' ? 'Pago de cliente' : t.tipo)
                            const tipoCls = esTx ? 'badge--tipo-' + t.tipo.toLowerCase().replace(/ /g, '-')
                                          : (t.origen === 'pago_cliente' ? 'mov-badge mov-badge--pago' : (t.categoria === 'sueldos' ? 'mov-badge mov-badge--sueldo' : 'mov-badge mov-badge--egreso'))
                        %>
                            <tr class="<%= sinSaldar ? 'venta-cc-pendiente' : '' %>" <%= sinSaldar ? 'title="Venta a cuenta corriente — todavía no se saldó"' : '' %>>
                                <td class="fw-semibold text-orange"><%= codigoMov(t) %></td>
                                <td>
                                    <%= formatFecha(t.fecha) %>
                                    <% if (cargadoOtroDia) { %><div class="mov-cargado" title="Día en que se cargó en el sistema">Cargado el <%= formatFecha(t.cargado_en) %></div><% } %>
                                </td>
                                <td><span class="badge <%= tipoCls %>"><%= tipoTxt %></span></td>
                                <td><%= t.persona %></td>
                                <td>
                                    <%= t.descripcion %>
                                    <% if (t.es_tercero) { %><div class="mov-cargado">Pagado por un cliente con transferencia a tercero</div><% } %>
                                </td>
                                <td><small class="text-muted"><%= metodoTexto[t.metodo_pago] || t.metodo_pago || '—' %></small></td>
                                <td class="transaccion-monto mov-monto mov-monto--<%= t.sentido %>">
                                    <%= t.sentido === 'salida' ? '−' : (t.sentido === 'entrada' ? '+' : '') %><%= money(t.monto) %>
                                    <div class="mov-sentido">
                                        <% if (t.sentido === 'entrada') { %>Entró<% } else if (t.sentido === 'salida') { %>Salió<% } else { %>A cuenta corriente<% } %>
                                    </div>
                                    <% if (sinSaldar) { %>
                                        <div><span class="badge rounded-pill px-2 py-1 badge-pendiente" style="font-size:0.62rem;white-space:nowrap">Sin saldar</span></div>
                                    <% } %>
                                </td>
                                <td class="td-acciones">
                                    <% if (esTx) { %>
                                        <button type="button" class="btn-secondary btn-sm btn-ver-transaccion"
                                            data-real-id="<%= t.id %>"
                                            data-id="<%= codigoMov(t) %>" data-tipo="<%= t.tipo %>"
                                            data-cliente="<%= t.persona %>" data-cliente-id="<%= t.cliente_id || '' %>"
                                            data-descripcion="<%= t.descripcion %>"
                                            data-fecha="<%= formatFecha(t.fecha) %>" data-fecha-iso="<%= String(t.fecha || '').slice(0, 10) %>"
                                            data-cargado="<%= formatFechaHora(t.cargado_en) %>"
                                            data-monto="<%= t.monto %>"
                                            data-metodo-pago="<%= t.metodo_pago || '' %>"
                                            data-op-id="<%= t.id_op_encabezado || '' %>"
                                            data-nro-remito="<%= t.nro_remito || '' %>"
                                            data-remito-firmado="<%= t.tiene_remito_firmado ? '1' : '' %>">
                                            Ver
                                        </button>
                                        <% if (puedeCorregir) { %>
                                            <button type="button" class="btn-secondary btn-sm btn-borrar-transaccion"
                                                data-id="<%= t.id %>" data-codigo="<%= codigoMov(t) %>"
                                                data-cliente="<%= t.persona %>"
                                                data-monto="<%= money(t.monto) %>"
                                                data-tiene-op="<%= t.id_op_encabezado ? '1' : '' %>"
                                                title="Eliminar">
                                                <%- icon('trash', { size: 14 }) %>
                                            </button>
                                        <% } %>
                                    <% } else if (t.origen === 'pago_cliente') { %>
                                        <a href="/clientes/cuentas/<%= t.cliente_id %>" class="btn-secondary btn-sm" title="Ver la cuenta corriente del cliente">Ver cuenta</a>
                                    <% } else { %>
                                        <% if (t.id_pago_empleado) { %>
                                            <a href="/compras/recibo/<%= t.id_pago_empleado %>" class="btn-secondary btn-sm" target="_blank" rel="noopener">Recibo</a>
                                        <% } %>
                                        <a href="/compras?<%= new URLSearchParams(Object.assign({ preset: 'rango', fechaDesde: String(t.fecha).slice(0, 10), fechaHasta: String(t.fecha).slice(0, 10), categoria: t.categoria_egreso || '' }, t.id_empleado ? { empleado: t.id_empleado } : {})).toString() %>"
                                           class="btn-secondary btn-sm" title="Ver en Compras / Pagos">Ver</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (totalPaginas > 1) { %>
                <%
                    const qs = Object.entries(filtros).filter(([, v]) => v !== '' && v != null).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
                    const base = '/transacciones?' + (qs ? qs + '&' : '');
                %>
                <nav class="pagination" style="display:flex;justify-content:center;align-items:center;gap:0.75rem;padding:1rem 0;margin-top:0.5rem">
                    <% if (pagina > 1) { %>
                        <a href="<%= base %>page=<%= pagina - 1 %>" class="btn-secondary btn-sm">← Anterior</a>
                    <% } else { %>
                        <span class="btn-secondary btn-sm" style="opacity:0.4;pointer-events:none">← Anterior</span>
                    <% } %>
                    <span style="font-weight:600">Página <%= pagina %> de <%= totalPaginas %> (<%= totalTransacciones %> resultados)</span>
                    <% if (pagina < totalPaginas) { %>
                        <a href="<%= base %>page=<%= pagina + 1 %>" class="btn-secondary btn-sm">Siguiente →</a>
                    <% } else { %>
                        <span class="btn-secondary btn-sm" style="opacity:0.4;pointer-events:none">Siguiente →</span>
                    <% } %>
                </nav>
            <% } %>

        </main>

        <!-- Modal detalle transaccion -->
        <div id="modal-transaccion" class="modal-overlay" style="display:none">
            <div class="modal-box tx-modal">
                <div class="modal-header">
                    <div class="tx-modal__heading">
                        <h2 class="modal-title">Detalle de transacción</h2>
                        <span id="modal-t-id" class="tx-modal__id"></span>
                    </div>
                    <button type="button" class="modal-close" id="cerrarModalTransaccion" aria-label="Cerrar"><%- icon('x', { size: 18 }) %></button>
                </div>

                <div class="tx-modal__body">
                    <div class="tx-hero">
                        <div>
                            <span class="tx-hero__label">Monto</span>
                            <span class="tx-hero__value" id="modal-t-monto"></span>
                        </div>
                        <span id="modal-t-tipo" class="badge"></span>
                    </div>

                    <div class="tx-datos">
                        <div class="tx-row">
                            <span class="tx-row__label">Cliente</span>
                            <span class="tx-row__value" id="modal-t-cliente"></span>
                        </div>
                        <div class="tx-row" id="filaFechaPago">
                            <span class="tx-row__label" id="modal-t-fecha-label">Fecha de pago</span>
                            <span class="tx-row__value">
                                <span id="modal-t-fecha"></span>
                                <% if (puedeCorregir) { %>
                                    <button type="button" class="tx-link-btn" id="btnEditarFechaPago">Corregir</button>
                                <% } %>
                            </span>
                        </div>
                        <% if (puedeCorregir) { %>
                        <form id="formFechaPago" method="POST" class="tx-metodo-edit" style="display:none">
                            <input type="date" name="fecha" id="inputFechaPagoEdit" max="<%= hoyISO() %>" required aria-label="Fecha de pago">
                            <button type="submit" class="btn-secondary btn-sm">Guardar</button>
                            <button type="button" class="btn-secondary btn-sm" id="btnCancelarFechaPago">Cancelar</button>
                        </form>
                        <% } %>
                        <div class="tx-row">
                            <span class="tx-row__label">Cargado el</span>
                            <span class="tx-row__value" id="modal-t-cargado"></span>
                        </div>
                        <div class="tx-row" id="filaMetodoPago">
                            <span class="tx-row__label">Método de pago</span>
                            <span class="tx-row__value">
                                <span class="tx-pago" id="modal-t-metodo-pago"></span>
                                <% if (puedeCorregir) { %>
                                    <button type="button" class="tx-link-btn" id="btnEditarMetodoPago">Corregir</button>
                                <% } %>
                            </span>
                        </div>
                        <% if (puedeCorregir) { %>
                        <form id="formMetodoPago" method="POST" class="tx-metodo-edit" style="display:none">
                            <select name="metodo_pago" id="selectMetodoPagoEdit" data-tercero>
                                <option value="efectivo">Efectivo</option>
                                <option value="transferencia">Transferencia</option>
                                <option value="cheque">Cheque</option><option value="echeq">Echeq</option>
                                <option value="cuenta_corriente" id="optCuentaCorriente">Cuenta corriente</option>
                            </select>
                            <button type="submit" class="btn-secondary btn-sm">Guardar</button>
                            <button type="button" class="btn-secondary btn-sm" id="btnCancelarMetodoPago">Cancelar</button>
                        </form>
                        <% } %>
                        <div class="tx-row tx-row--bloque">
                            <span class="tx-row__label">Descripción</span>
                            <span class="tx-row__value" id="modal-t-descripcion"></span>
                        </div>
                    </div>

                    <div class="tx-files" id="modal-t-files">
                        <span class="tx-files__title"><%- icon('clipboard', { size: 14 }) %> Archivos</span>
                        <div class="tx-files__links" id="modal-t-files-links"></div>
                    </div>
                </div>

                <div class="tx-modal__actions">
                    <button type="button" class="btn-secondary" id="cerrarModalTransaccionBtn">Cerrar</button>
                </div>
            </div>
        </div>

        <!-- Confirmación de borrado: la operación no se puede recuperar -->
        <div id="modal-borrar-transaccion" class="modal-overlay" style="display:none">
            <div class="modal-box tx-modal">
                <div class="modal-header">
                    <div class="tx-modal__heading">
                        <h2 class="modal-title">Eliminar transacción</h2>
                        <span id="borrar-t-id" class="tx-modal__id"></span>
                    </div>
                    <button type="button" class="modal-close" id="cerrarModalBorrar" aria-label="Cerrar"><%- icon('x', { size: 18 }) %></button>
                </div>

                <div class="tx-modal__body">
                    <div class="tx-alerta-borrado">
                        <%- icon('alert', { size: 20 }) %>
                        <div>
                            <strong>Esta acción no se puede deshacer.</strong>
                            <p class="mb-0" id="borrar-t-alcance"></p>
                        </div>
                    </div>
                    <div class="tx-datos">
                        <div class="tx-row">
                            <span class="tx-row__label">Cliente</span>
                            <span class="tx-row__value" id="borrar-t-cliente"></span>
                        </div>
                        <div class="tx-row">
                            <span class="tx-row__label">Monto</span>
                            <span class="tx-row__value" id="borrar-t-monto"></span>
                        </div>
                    </div>
                </div>

                <div class="tx-modal__actions">
                    <button type="button" class="btn-secondary" id="cancelarModalBorrar">Cancelar</button>
                    <form method="POST" id="formBorrarTransaccion" class="d-inline">
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    </form>
                </div>
            </div>
        </div>

        <%# Íconos para los enlaces de archivo, que los arma el JS del modal %>
        <script id="tx-icons" type="application/json"><%- JSON.stringify({
          remito: icon('receipt', { size: 15 }),
          firmado: icon('checkCircle', { size: 15 }),
        }) %></script>
