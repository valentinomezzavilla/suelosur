<div class="page-header">
  <h4 class="page-title"><%- icon('map', { size: 18 }) %> Mapa de Contenedores</h4>
  <div class="d-flex gap-2 flex-wrap">
    <button type="button" id="btnRecargarMapa" class="btn btn-outline-secondary btn-sm"><%- icon('refresh', { size: 14 }) %> Actualizar</button>
    <% if (puedeEditar) { %>
      <a href="/alquileres/contenedores" class="btn btn-outline-secondary btn-sm">← Alquileres</a>
    <% } %>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
  <div class="mapa-leyenda">
    <span><span class="mapa-leyenda__dot mapa-leyenda__dot--pendiente"></span>Pendiente de iniciar</span>
    <span><span class="mapa-leyenda__dot mapa-leyenda__dot--en_curso"></span>En curso</span>
    <span><span class="mapa-leyenda__dot mapa-leyenda__dot--por_finalizar"></span>Finaliza mañana</span>
    <span><span class="mapa-leyenda__dot mapa-leyenda__dot--a_retirar"></span>A retirar</span>
    <span><span class="mapa-leyenda__dot mapa-leyenda__dot--aprox"></span>Borde punteado = ubicación aproximada</span>
  </div>
  <small class="text-muted" id="mapaResumen"></small>
</div>

<div class="mapa-cont-wrap mb-3" id="mapaWrap">
  <div id="mapaContenedores"></div>
  <div class="mapa-cont-overlay" id="mapaOverlay" style="display:none">
    <div class="mapa-cont-overlay__msg" id="mapaOverlayMsg"></div>
  </div>
  <div class="mapa-cont-aviso" id="mapaAviso" style="display:none">
    <span id="mapaAvisoTxt"></span>
    <button type="button" id="mapaAvisoCancelar">Cancelar</button>
  </div>
</div>

<div class="card-modern mb-3" id="cardSinUbicar" style="display:none">
  <div class="card-modern-header card-modern-header--atencion d-flex justify-content-between align-items-center">
    <span class="card-modern-title">Sin ubicar — no se pudo encontrar la dirección</span>
    <span class="badge badge-pendiente rounded-pill px-3" id="sinUbicarCount">0</span>
  </div>
  <div class="card-modern-body p-0" id="listaSinUbicar"></div>
</div>

<script>
  window.MAPA_CONTENEDORES = { puedeEditar: <%= puedeEditar ? 'true' : 'false' %> }
</script>
