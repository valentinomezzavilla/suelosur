<%
  const d = alquiler.detalle || {}
  const metodos = [['efectivo','Efectivo'],['transferencia','Transferencia'],['cheque','Cheque'],['echeq','Echeq'],['cuenta_corriente','Cuenta corriente'],['a_convenir','A convenir una vez finalizado']]
  // El método actual se muestra aunque no esté en la lista (ej. saldo a favor): si no,
  // el select caería en "Sin especificar" y al guardar se perdería.
  const metodoActual = alquiler.metodo_pago || d.metodo_pago || ''
  if (metodoActual && !metodos.some(([k]) => k === metodoActual)) metodos.push([metodoActual, metodoActual === 'saldo_a_favor' ? 'Saldo a favor' : metodoActual])
  const calle = d.domicilio_calle || d.domicilio_entrega || ''
  const numero = d.domicilio_numero || ''
  // Fecha inicio = entrega planificada; fecha fin = inicio + plazo (días).
  // Plazo nulo = alquiler sin fecha de fin, así que no hay fin que mostrar.
  // precio_alquiler NULL = alquiler sin precio: el precio y el método de pago no se editan acá,
  // se asignan en Cobranzas → Asignar precio (con la validación de cuenta corriente).
  const sinPrecio = d.precio_alquiler == null
  const fechaInicioVal = alquiler.fecha_entrega_planificada || ''
  const sinFechaFinVal = d.plazo_alquiler == null
  // El plazo se guarda en DÍAS HÁBILES: hay que sumarlos como tales (sumarDiasHabiles),
  // no como días corridos, o la fecha de fin mostrada acá queda antes de la real.
  let fechaFinVal = ''
  if (fechaInicioVal && !sinFechaFinVal) {
    fechaFinVal = sumarDiasHabiles(fechaInicioVal, parseInt(d.plazo_alquiler))
  }
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0 text-dark-title"><%- icon('box', { size: 18 }) %> Editar Alquiler OP-<%= String(alquiler.nro_op).padStart(4,'0') %></h4>
  <a href="/alquileres/contenedores/<%= alquiler.id %>" class="btn btn-sm btn-outline-secondary">← Volver</a>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <p class="text-muted small mb-3">Cliente: <strong><%= alquiler.cliente_nombre %></strong> · El cliente y el contenedor asignado no se cambian acá (usá anular + recrear o "Asignar contenedor").</p>
    <form action="/alquileres/contenedores/<%= alquiler.id %>?_method=PUT" method="POST">
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Calle</label><input name="calle" id="calle" class="form-control" value="<%= calle %>"></div>
        <div class="col-md-3"><label class="form-label">Número</label><input name="numero" class="form-control" value="<%= numero %>"></div>
        <div class="col-md-3"><label class="form-label">Obra</label><input name="obra" id="obraAlquiler" class="form-control" value="<%= alquiler.obra || '' %>"></div>
        <p class="form-hint col-12 mt-n2">Cargá la <strong>dirección</strong> (calle) o la <strong>obra</strong> — al menos uno.</p>
        <div class="col-md-3"><label class="form-label">Zona</label>
          <select name="zona_entrega" class="form-select">
            <option value="">— Sin zona —</option>
            <% (typeof zonas !== 'undefined' ? zonas : []).forEach(z => { %>
              <option value="<%= z.nombre %>" <%= (d.zona_entrega||'').toLowerCase() === z.nombre.toLowerCase() ? 'selected' : '' %>><%= z.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3"><label class="form-label">Fecha inicio</label><input type="date" name="fechaInicio" class="form-control" value="<%= fechaInicioVal %>"></div>
        <div class="col-md-3">
          <label class="form-label">Fecha fin</label>
          <input type="date" name="fechaFin" class="form-control" value="<%= fechaFinVal %>" <%= sinFechaFinVal ? 'disabled' : '' %>>
          <label class="toggle-row mt-1">
            <input type="checkbox" name="sin_fecha_fin" value="1" id="editSinFechaFin" <%= sinFechaFinVal ? 'checked' : '' %>>
            <span class="small">Sin fecha de fin</span>
          </label>
        </div>
        <% if (sinPrecio) { %>
        <div class="col-md-6">
          <label class="form-label">Precio y método de pago</label>
          <p class="form-control-plaintext mb-0">
            <span class="badge rounded-pill px-2 badge-pendiente">Sin precio</span>
            <a href="/alquileres/contenedores/cobranzas#op-<%= alquiler.id %>">Asignar precio</a> en Cobranzas
          </p>
        </div>
        <% } else { %>
        <div class="col-md-3"><label class="form-label">Precio</label><input type="number" step="0.01" min="0" name="precio_alquiler" class="form-control" value="<%= d.precio_alquiler || 0 %>"></div>
        <div class="col-md-3"><label class="form-label">Método de pago</label>
          <select name="metodo_pago" class="form-select">
            <option value="">— Sin especificar —</option>
            <% metodos.forEach(([k,l]) => { %><option value="<%= k %>" <%= metodoActual===k?'selected':'' %>><%= l %></option><% }) %>
          </select>
        </div>
        <% } %>
        <div class="col-12"><label class="form-label">Observaciones</label><textarea name="observaciones" class="form-control" rows="2"><%= alquiler.observaciones || '' %></textarea></div>
        <% // Las mismas OP que actualiza actualizarCompartidosGrupo: sin cobrar y, con cobro por
           // contenedor, todavía sin retirar.
           const restantes = alquiler.grupo ? alquiler.grupo.ops.filter(o => o.estado !== 'anulado' && o.id !== alquiler.id
             && !o.cobrada && (alquiler.grupo.cobro_modo === 'alquiler' || o.abierta)).length : 0
           if (restantes > 0) { %>
          <label class="toggle-row col-12">
            <input type="checkbox" name="aplicar_grupo" value="1" checked>
            <span>Aplicar dirección, obra, zona, método de pago y observaciones a <%= restantes === 1 ? 'el otro contenedor' : `los otros ${restantes} contenedores` %> del alquiler que todavía no se cobr<%= restantes === 1 ? 'ó' : 'aron' %> (plazo, precio y fechas son de cada uno)</span>
          </label>
        <% } %>
      </div>
      <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-naranja px-4">Guardar cambios</button>
        <a href="/alquileres/contenedores/<%= alquiler.id %>" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
  // El check libera o bloquea la fecha de fin
  (function () {
    var chk = document.getElementById('editSinFechaFin')
    var fin = document.querySelector('input[name="fechaFin"]')
    if (!chk || !fin) return
    chk.addEventListener('change', function () {
      fin.disabled = chk.checked
      if (chk.checked) fin.value = ''
    })
  })()
  // Destino: al menos uno entre dirección (calle) y obra
  document.querySelector('form[action*="_method=PUT"]')?.addEventListener('submit', function (e) {
    var calleV = document.getElementById('calle')?.value.trim()
    var obraV  = document.getElementById('obraAlquiler')?.value.trim()
    if (!calleV && !obraV) {
      alert('Cargá la dirección (calle) o la obra. Al menos uno es obligatorio.')
      e.preventDefault()
    }
  })
</script>
