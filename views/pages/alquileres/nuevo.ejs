<div class="page-header">
  <div>
    <a href="/alquileres/contenedores" class="back-link">← Alquileres</a>
    <h1 class="page-title">Nuevo Alquiler de Contenedor</h1>
  </div>
</div>

<script id="precios-config" type="application/json"><%- JSON.stringify(configPrecios) %></script>
<script id="plazos-config" type="application/json"><%- JSON.stringify(configPlazos) %></script>

<!-- ── Paso 1: seleccionar contenedor ─────────────────────────── -->
<div class="form-section">
  <h3 class="form-section__title">Seleccioná un contenedor</h3>

  <div class="cont-tabs-row">
    <div class="cont-tabs" role="tablist">
      <button type="button" class="cont-tab is-active" data-target="disponibles" role="tab">
        Disponibles <span class="cont-tab__count"><%= disponibles.length %></span>
      </button>
      <button type="button" class="cont-tab cont-tab--warn" data-target="porFinalizar" role="tab">
        Próximos a finalizar <span class="cont-tab__count"><%= porLiberar.length %></span>
      </button>
    </div>
    <button type="button" id="btnCargarFinalizado" class="btn-secondary btn-sm">＋ Cargar alquiler histórico</button>
  </div>
  <p class="form-hint" style="margin-top:0.6rem">
    <strong>Próximos a finalizar</strong>: contenedores que están en alquiler (sin un próximo ya programado). Al elegir uno, programás el <strong>próximo alquiler</strong> encadenado, que arranca cuando se libera.
  </p>

  <div id="listaDisponibles" class="alquiler-cards-grid" style="margin-top:1rem">
    <% if (disponibles.length===0) { %>
      <%- include('../../partials/empty_state', { icono: '📦' , mensaje: 'No hay contenedores disponibles.' }) %>
        <% } %>
          <% disponibles.forEach(c=> { %>
            <div class="alquiler-card" data-id="<%= c.id %>" data-numero="<%= c.numero_contenedor %>">
              <div class="alquiler-card__numero">#<%= c.numero_contenedor %>
              </div>
              <span class="badge badge--con-stock">Disponible</span>
              <button type="button" class="btn-seleccionar-cont btn-primary btn-sm">Seleccionar</button>
            </div>
            <% }) %>
  </div>

  <div id="listaPorFinalizar" class="alquiler-cards-grid" style="display:none;margin-top:1rem">
    <% if (!porLiberar.length) { %>
      <%- include('../../partials/empty_state', { icono: '📦', mensaje: 'No hay contenedores en alquiler para programar el próximo alquiler.' }) %>
    <% } %>
    <% porLiberar.forEach(c=> { %>
      <div class="alquiler-card alquiler-card--por-liberar" data-id="<%= c.id %>"
        data-numero="<%= c.numero_contenedor %>" data-fin="<%= c.fecha_liberacion %>"
        data-alquiler-actual="<%= c.alquiler_actual_id %>">
        <div class="alquiler-card__numero">#<%= c.numero_contenedor %>
        </div>
        <span class="badge badge--pendiente">Libera: <%= formatFecha(c.fecha_liberacion) %></span>
        <small class="text-muted">
          <%= c.cliente_actual %>
        </small>
        <button type="button" class="btn-seleccionar-cont btn-primary btn-sm">Seleccionar</button>
      </div>
      <% }) %>
  </div>
</div>

<!-- ── Paso 2: modal con el formulario de alquiler ────────────── -->
<div id="modal-alquiler" class="modal-overlay" style="display:none">
  <div class="modal-box modal-box--lg">
    <div class="modal-header">
      <h2 class="modal-title">Nuevo alquiler — <span id="modal-cont-label"></span></h2>
      <button type="button" class="modal-close" id="cerrarModalAlquiler">✕</button>
    </div>

    <form action="/alquileres/contenedores" method="POST" id="formNuevoAlquiler" class="modal-body">
      <input type="hidden" name="id_contenedor" id="inputContenedorId">
      <input type="hidden" name="alquiler_actual_id" id="inputAlquilerActualId">
      <input type="hidden" name="lat" id="inputLat">
      <input type="hidden" name="lng" id="inputLng">

      <!-- Carga histórica: alquiler viejo, terminado o todavía en curso -->
      <label class="toggle-row" style="margin-bottom:0.4rem">
        <input type="checkbox" id="checkFinalizado" name="finalizado" value="1">
        <span>Alquiler histórico (ya empezado)</span>
      </label>
      <div id="bloqueHistorico" style="display:none;margin:0 0 0.9rem">
        <div class="form-group">
          <label for="estadoHistorico">¿En qué estado está?</label>
          <select name="estado_historico" id="estadoHistorico">
            <option value="finalizado">Ya finalizó</option>
            <option value="en_curso">Sigue en curso</option>
          </select>
        </div>
        <div class="form-group" id="grupoContHistorico" style="display:none">
          <label for="contHistorico">Contenedor que está en el domicilio *</label>
          <select id="contHistorico">
            <option value="">Seleccionar contenedor...</option>
            <% disponibles.forEach(c => { %>
              <option value="<%= c.id %>">N° <%= c.numero_contenedor %></option>
            <% }) %>
          </select>
        </div>
        <p id="finalizadoHint" class="form-hint" style="margin:0">
          Se registra el ingreso con la fecha indicada y queda en el historial del cliente.
          No ocupa un contenedor físico ni genera tareas para el chofer.
        </p>
        <p id="enCursoHint" class="form-hint" style="display:none;margin:0">
          El contenedor queda ocupado en el domicilio del cliente, sin fecha de fin y sin pasar
          por despacho. Se retira cuando lo marques a mano.
        </p>
      </div>

      <!-- Cliente -->
      <div class="form-section">
        <%- include('../../partials/buscar_cliente') %>
      </div>

      <!-- Dirección -->
      <div class="form-section">
        <h3 class="form-section__title">Dirección de entrega</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label for="calle">Calle</label>
            <input type="text" name="calle" id="calle" placeholder="Ej: Av. Colón">
          </div>
          <div class="form-group">
            <label for="numero">Número</label>
            <input type="text" name="numero" id="numero" placeholder="Ej: 1234">
          </div>
        </div>
        <div class="form-group">
          <label for="obraAlquiler">Obra</label>
          <input type="text" name="obra" id="obraAlquiler" placeholder="Nombre o referencia de la obra">
        </div>
        <p class="form-hint">Cargá la <strong>dirección</strong> (calle) o la <strong>obra</strong> — al menos uno.</p>
        <div class="direccion-acciones">
          <div class="form-group">
            <label for="zona">Zona</label>
            <select name="zona_entrega" id="zona">
              <option value="">— Sin zona —</option>
              <% (typeof zonas !== 'undefined' ? zonas : []).forEach(z => { %>
                <option value="<%= z.nombre %>"><%= z.nombre %></option>
              <% }) %>
            </select>
          </div>
          <button type="button" id="btnBuscarDireccion" class="btn-secondary btn-buscar-mapa direccion-mapbtn"><%- icon('mapPin', { size: 15 }) %> Buscar en mapa</button>
        </div>
        <p id="msgMapa" class="form-hint" style="display:none">Ingresá calle y número para buscar.</p>
        <div id="mapaEntrega" style="display:none;margin-top:0.75rem">
          <div id="mapaContenedor" style="width:100%;height:250px;border-radius:8px"></div>
        </div>
      </div>

      <!-- Fechas -->
      <div class="form-section">
        <h3 class="form-section__title">Período de alquiler</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label for="fechaInicio">Fecha inicio *</label>
            <input type="date" name="fechaInicio" id="fechaInicio" required>
          </div>
          <div class="form-group" id="grupoFechaFin">
            <label for="fechaFin">Fecha fin *</label>
            <input type="date" name="fechaFin" id="fechaFin" required>
          </div>
        </div>
        <p class="form-hint" id="hintPlazo">
          La fecha de fin se calcula sola: los clientes con <strong>cuenta corriente habilitada</strong>
          tienen <strong><%= configPlazos.cuenta_corriente %> días</strong> desde el inicio;
          el resto, <strong><%= configPlazos.estandar %> días</strong>.
          <span id="plazoActual" class="fw-semibold"></span>
        </p>
        <label class="toggle-row" id="rowEditarFechaFin">
          <input type="checkbox" id="checkEditarFechaFin" name="editar_fecha_fin" value="1">
          <span>Editar fecha de fin manualmente</span>
        </label>
        <p class="form-hint" id="avisoEnCurso" style="display:none">
          <strong>Alquiler ya en curso:</strong> la fecha de inicio es anterior a hoy, así que se carga
          con el contenedor ya entregado en el domicilio, sin pasar por despacho.
        </p>
        <label class="toggle-row" id="rowSinFechaFin" style="display:none">
          <input type="checkbox" id="checkSinFechaFin" name="sin_fecha_fin" value="1">
          <span>Sin fecha de fin (tiempo indeterminado)</span>
        </label>
        <p class="form-hint" id="hintSinFechaFin" style="display:none">
          El contenedor queda en el domicilio hasta que lo marques para retiro a mano.
          No se vence solo ni aparece en “próximos a finalizar”.
        </p>
      </div>

      <!-- Precio -->
      <div class="form-section">
        <h3 class="form-section__title">Precio</h3>
        <div id="precioAlquilerDisplay" class="resumen-valor">—</div>
        <label class="toggle-row">
          <input type="checkbox" id="checkEditarPrecio">
          <span>Editar precio manualmente</span>
        </label>
        <input type="number" name="precio_alquiler" id="precioAlquilerInput" class="input-sm" style="display:none"
          min="0" step="100">
      </div>

      <!-- Método de pago -->
      <%- include('../../partials/metodo_pago') %>

      <!-- Chofer / Camión -->
      <div class="form-section" id="seccionChoferCamion">
        <h3 class="form-section__title">Chofer y camión (opcional)</h3>
        <p class="form-hint">Podés asignarlos ahora o más tarde desde el detalle del alquiler.</p>
        <div class="form-row-2">
          <div class="form-group">
            <label for="selNuevoChofer">Chofer</label>
            <select name="id_chofer" id="selNuevoChofer" class="form-select">
              <option value="">— Sin asignar —</option>
              <% choferesDisp.forEach(c => { %>
                <option value="<%= c.id %>" data-camion="<%= c.camion_id || '' %>"><%= c.nombre %> <%= c.apellido %><%= c.ocupado ? ' 🔴' : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="selNuevoCamion">Camión</label>
            <select name="id_camion" id="selNuevoCamion" class="form-select">
              <option value="">— Sin asignar —</option>
              <% camionesDisp.forEach(v => { %>
                <option value="<%= v.id %>" data-chofer="<%= v.chofer_id || '' %>"><%= [v.patente, v.nombre].filter(Boolean).join(' · ') %><%= v.ocupado ? ' 🔴' : '' %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <script>
          (function () {
            var selC = document.getElementById('selNuevoChofer')
            var selV = document.getElementById('selNuevoCamion')
            if (!selC || !selV) return
            var sync = false
            selC.addEventListener('change', function () {
              if (sync) return
              var cam = selC.options[selC.selectedIndex]?.getAttribute('data-camion')
              if (cam) { sync = true; selV.value = String(cam); sync = false }
            })
            selV.addEventListener('change', function () {
              if (sync) return
              var cho = selV.options[selV.selectedIndex]?.getAttribute('data-chofer')
              if (cho) { sync = true; selC.value = String(cho); sync = false }
            })
          })()
        </script>
      </div>

        <!-- Observaciones -->
        <div class="form-section">
          <h3 class="form-section__title">Observaciones</h3>
          <div class="form-group">
            <textarea name="observaciones" rows="2" placeholder="Notas adicionales..."></textarea>
          </div>
        </div>

        <!-- Resumen -->
        <div class="form-section alquiler-resumen">
          <h3 class="form-section__title">Resumen</h3>
          <div class="resumen-grid">
            <span class="resumen-label">Cliente</span> <span class="resumen-valor" id="res-cliente">—</span>
            <span class="resumen-label">Dirección</span> <span class="resumen-valor" id="res-direccion">—</span>
            <span class="resumen-label">Contenedor</span> <span class="resumen-valor" id="res-contenedor">—</span>
            <span class="resumen-label">Inicio</span> <span class="resumen-valor" id="res-inicio">—</span>
            <span class="resumen-label">Fin</span> <span class="resumen-valor" id="res-fin">—</span>
            <span class="resumen-label">Días</span> <span class="resumen-valor" id="res-dias">—</span>
            <span class="resumen-label">Pago</span> <span class="resumen-valor" id="res-pago">—</span>
          </div>
          <div id="res-total" class="resumen-total" style="display:none">
            <span>Total</span>
            <span id="res-total-valor"></span>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="cancelarModalAlquiler">Cancelar</button>
          <button type="submit" class="btn-finalizar" style="width:auto">Confirmar alquiler</button>
        </div>
    </form>
  </div>
</div>